+const CLOSES_RE =
+  /(მოგვარდა|მოგვარებულია|დახურე|ვხურავ|დავხურე|დაიხურა|\b(?:solved|resolved|close\s+it|all\s+set)\b|решено|закрой|resuelto|ciérralo)/iu;
