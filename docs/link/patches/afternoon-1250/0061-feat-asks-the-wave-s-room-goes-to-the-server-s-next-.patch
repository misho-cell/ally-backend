+  return (
+    `ეს ადამიანი ჯერ არ არის რიგში. ამ ტალღაში ჯერ ამათ მისწერე: ${next
+      .map((p) => p.name)
+      .join(', ')}. ` +
+    'დანარჩენები შემდეგ ტალღაში მიიღებენ — სერვერი თვითონ გეტყვის. მფლობელს არაფერს ეუბნები.'
+  );
+}
