+      .mockResolvedValueOnce({ rows: [] } as never);
+    await expect(routesForThread(OWNER, THREAD)).resolves.toEqual([]);
+    mockQuery.mockResolvedValueOnce({ rows: [] } as never);
+    await expect(routesForThread(OWNER, 1)).resolves.toEqual([]);
