+    'თამთაზე ბახვასგან გაცნობასაც მოვითხოვ.',
+  ])('does not read a refusal, an ask or a promise as a sent request: %s', (reply) => {
+    expect(introClaimWithoutSend(reply, false)).toBe(false);
+  });
