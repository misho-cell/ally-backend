 src/services/chat.service.ts                  | 19 ++++++++++++-
 src/services/smallTalk.ts                     | 19 +++++++++++++
 3 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/src/services/__tests__/smallTalkIsNeverAGoal.test.ts b/src/services/__tests__/smallTalkIsNeverAGoal.test.ts
