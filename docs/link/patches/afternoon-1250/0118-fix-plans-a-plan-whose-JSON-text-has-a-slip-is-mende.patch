+import { repairedPlanJson } from '../planJsonRepair';
+import { parsePlan } from '../taskPlans.service';
+
+/** 4522: plans refused as „not valid JSON" for a slip in the middle, and lost. */
+describe('a plan whose JSON text has a slip', () => {
+  // The 15:30Z case, as the tool log shows it: a lone quote before the routes' closing bracket.
+  const strayQuote =
+    '{"solved_when": "ვაკეში ნოტარიუსი მოიძებნა", "routes": [{"name": "პირადი კონტაქტი", "status": "waiting"}, "], ' +
+    '"people_to_involve": [{"name": "გია ხელოსანი", "phone": "+995599000370", "route": "პირადი კონტაქტი"}], "never": []}';
+
+  it('is mended when the slip is a lone quote before a bracket', () => {
+    expect(repairedPlanJson(strayQuote)).toMatchObject({
+      routes: [{ name: 'პირადი კონტაქტი', status: 'waiting' }],
+      people_to_involve: [{ name: 'გია ხელოსანი' }],
+    });
+  });
+
+  it('is mended when a Georgian „ was closed with an ASCII quote', () => {
+    const text = '{"solved_when": "„საცდელი ლოჯისტიკა"ს ბუღალტერი", "routes": []}';
+    expect(repairedPlanJson(text)).toEqual({
+      solved_when: '„საცდელი ლოჯისტიკა“ს ბუღალტერი',
+      routes: [],
+    });
+  });
+
+  it('stays unmended when it really was cut off', () => {
+    expect(repairedPlanJson('{"solved_when": "ვაკეში ნოტარ')).toBeUndefined();
+  });
+
+  it('reaches the plan checks instead of the „not valid JSON" refusal', () => {
+    const outcome = parsePlan(strayQuote);
+    if (!outcome.ok) expect(outcome.error).not.toContain('not valid JSON');
+  });
+});
diff --git a/src/services/planJsonRepair.ts b/src/services/planJsonRepair.ts
new file mode 100644
index 0000000..88216e0
--- /dev/null
+++ b/src/services/planJsonRepair.ts
@@ -0,0 +1,46 @@
+/**
+ * 4522 (daily check, 10 Oct 18:43Z): propose_task_plan refused six plans in
+ * four days as „not valid JSON", and the run lost each one. The tool log shows
+ * the parse failing in the MIDDLE of the text („Unexpected token p at position
+ * 148" of 270), not at its end — so not a cut-off: a slip in an otherwise
+ * whole plan. The one fully visible case:
+ *
+ *   "routes": [{"name": "პირადი კონტაქტი", "status": "waiting"}, "], "people_to_involve": …
+ *
+ * Only these slips are mended, and only after a parse has failed; what comes
+ * out is used only if it parses, and it goes through every check a plan sent
+ * as an object goes through.
+ */
+const REPLACEMENT_CHAR_RE = /�/gu;
+/** A lone quote right before a closing bracket: `}, "]` → `}]`. */
+const STRAY_QUOTE_RE = /([,{[\]}])\s*"\s*(?=[\]}])/gu;
+/** A comma right before a closing bracket: `}, ]` → `}]`. */
+const TRAILING_COMMA_RE = /,\s*(?=[\]}])/gu;
+/** A Georgian „ closed with an ASCII quote, which ends the JSON string early. */
+const GEORGIAN_QUOTE_RE = /„([^"“\n]{0,200})"(?=[^,:}\]\s])/gu;
+
+const REPAIRS: readonly ((text: string) => string)[] = [
+  (text) => text.replace(REPLACEMENT_CHAR_RE, ''),
+  (text) => text.replace(GEORGIAN_QUOTE_RE, '„$1“'),
+  (text) => text.replace(STRAY_QUOTE_RE, '$1'),
+  (text) => text.replace(TRAILING_COMMA_RE, ''),
+];
+
+function parsed(text: string): unknown {
+  try {
+    return JSON.parse(text) as unknown;
+  } catch {
+    return undefined;
+  }
+}
+
+/** The plan object behind slightly broken JSON text; undefined when it cannot be mended. */
+export function repairedPlanJson(text: string): unknown {
+  let mended = text;
+  for (const repair of REPAIRS) {
+    mended = repair(mended);
+    const value = parsed(mended);
+    if (value !== undefined) return value;
+  }
+  return undefined;
+}
