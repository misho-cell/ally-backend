+jest.mock('../../db/postgres/client', () => ({ __esModule: true, query: jest.fn() }));
+jest.mock('../notification.service', () => ({ __esModule: true, sendPushNotification: jest.fn() }));
+jest.mock('../threads.service', () => ({ __esModule: true, userLanguage: jest.fn() }));
