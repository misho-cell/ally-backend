+
   it('is recounted from the source tables, never incremented', async () => {
     await refreshAnswerStats(180279);
     const [sql, params] = mockQuery.mock.calls[0] as [string, unknown[]];
@@ -69,7 +85,8 @@ describe('the record', () => {
