From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 13:16:57 +0000
Subject: [PATCH] 1454: an introduction reply keeps one plan sentence
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Box 52940, run 3: „სანდროს ასისტენტს დაველაპარაკები და შევეცდები მოვაგვარო,
რომ სანდრომ გაგაცნოს ქეთა. სანდრო ფიქტიურის ასისტენტს დაველაპარაკები და
შევეცდები, ეს მოვაგვარო. დავიწყო?" — the model wrote its own plan sentence
and then the server's one it was handed. D739: one sentence, one question.
After the existing justification filter, every plan sentence after the
first is dropped; nothing else in the reply is touched. No new words.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 .../__tests__/planJustification.test.ts       | 25 +++++++++++++++++-
 src/services/chat.service.ts                  |  3 ++-
 src/services/planJustification.ts             | 26 +++++++++++++++++++
 3 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/src/services/__tests__/planJustification.test.ts b/src/services/__tests__/planJustification.test.ts
index fedba1f..3e2c3e1 100644
--- a/src/services/__tests__/planJustification.test.ts
+++ b/src/services/__tests__/planJustification.test.ts
@@ -1,6 +1,10 @@
 import { readFileSync } from 'fs';
 import { join } from 'path';
-import { withoutMatchJustification, withPlanSentence } from '../planJustification';
+import {
+  withOnePlanSentence,
+  withoutMatchJustification,
+  withPlanSentence,
+} from '../planJustification';
 
 /**
  * 1454 / D739: an introduction plan is one sentence and one question; the
@@ -69,3 +73,22 @@ describe('a plan reply without the plan sentence', () => {
     expect(withPlanSentence(said, 'ჯერ ვეძებ, ვინ შეძლებს ამაში დახმარებას.')).toBe(said);
   });
 });
+
+// 1454 (box 52940, run 3): the model's own plan sentence and then the server's, in one reply.
+describe('withOnePlanSentence', () => {
+  const RUN_3 =
+    'სანდროს ასისტენტს დაველაპარაკები და შევეცდები მოვაგვარო, რომ სანდრომ გაგაცნოს ქეთა. ' +
+    'სანდრო ფიქტიურის ასისტენტს დაველაპარაკები და შევეცდები, ეს მოვაგვარო. დავიწყო?';
+
+  it('keeps the first plan sentence and the question, and drops the second plan sentence', () => {
+    expect(withOnePlanSentence(RUN_3)).toBe(
+      'სანდროს ასისტენტს დაველაპარაკები და შევეცდები მოვაგვარო, რომ სანდრომ გაგაცნოს ქეთა. დავიწყო?',
+    );
+  });
+
+  it('leaves a reply with one plan sentence, and its news, exactly as written', () => {
+    const one =
+      'ვიპოვე ორი გზა.\n\nლიკას ასისტენტს დაველაპარაკები და შევეცდები, ლიკამ გაგაცნოთ ნინუცასთან. დავიწყო?';
+    expect(withOnePlanSentence(one)).toBe(one);
+  });
+});
diff --git a/src/services/chat.service.ts b/src/services/chat.service.ts
index d4f9e24..44077b6 100644
--- a/src/services/chat.service.ts
+++ b/src/services/chat.service.ts
@@ -88,6 +88,7 @@ import {
   carriesPlanSentence,
   withoutMatchJustification,
   withPlanSentence,
+  withOnePlanSentence,
 } from './planJustification';
 import { withOwnersNetwork } from './planVoice';
 import { offerReferral, referralTapOf } from './askReferral.service';
@@ -7721,7 +7722,7 @@ function withPlanInReply(
     // D739: the plan is its one sentence and one question — no sentence explaining the match.
     // 1454: a reply that said only why the match fits gets the server's plan sentence instead.
     return withClosingQuestion(
-      withPlanSentence(withoutMatchJustification(reply), plan.text),
+      withOnePlanSentence(withPlanSentence(withoutMatchJustification(reply), plan.text)),
       runLang(runId),
     );
   }
diff --git a/src/services/planJustification.ts b/src/services/planJustification.ts
index 0aec6db..32ce5f7 100644
--- a/src/services/planJustification.ts
+++ b/src/services/planJustification.ts
@@ -86,3 +86,29 @@ export function withPlanSentence(reply: string, planText: string): string {
   const news = last !== undefined && last.endsWith('?') ? sentences.slice(0, -1) : sentences;
   return news.length === 0 ? planText : `${news.join(' ')}\n\n${planText}`;
 }
+
+/**
+ * 1454 (box 52940, run 3): the reply carried the plan twice — the model's own
+ * „სანდროს ასისტენტს დაველაპარაკები და შევეცდები მოვაგვარო, რომ სანდრომ
+ * გაგაცნოს ქეთა." and then the server's sentence it was handed. The plan is
+ * one sentence (D739): the first one stays, every later plan sentence goes,
+ * and nothing else is touched.
+ */
+export function withOnePlanSentence(reply: string): string {
+  let seen = false;
+  return reply
+    .split(/\n\s*\n/u)
+    .map((paragraph) =>
+      paragraph
+        .split(SENTENCE_SPLIT_RE)
+        .filter((sentence) => {
+          if (!PLAN_SENTENCE_RE.test(sentence)) return true;
+          if (seen) return false;
+          seen = true;
+          return true;
+        })
+        .join(' '),
+    )
+    .filter((paragraph) => paragraph.trim() !== '')
+    .join('\n\n');
+}
