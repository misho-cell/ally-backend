 src/services/chat.service.ts                  |  9 +++++--
 src/services/memberCard.service.ts            |  5 ++--
 3 files changed, 34 insertions(+), 4 deletions(-)
 create mode 100644 src/services/__tests__/theCastsMatchTheColumns.test.ts

diff --git a/src/services/__tests__/theCastsMatchTheColumns.test.ts b/src/services/__tests__/theCastsMatchTheColumns.test.ts
new file mode 100644
index 0000000..270c6d9
--- /dev/null
+++ b/src/services/__tests__/theCastsMatchTheColumns.test.ts
@@ -0,0 +1,24 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+/**
+ * Ops, 11 Oct 13:42Z, from the live logs: two queries cast to the wrong column
+ * type, so Postgres refused them on every call — `GET /members/:id` answered
+ * 500 („text = integer": user_profile_kv.user_id is TEXT), and the plan-step
+ * tidy-up never removed a step („uuid = integer": conversations.id is a UUID).
+ */
+const source = (file: string): string => readFileSync(join(__dirname, '..', file), 'utf8');
+
+describe('the casts match the columns', () => {
+  it('reads a member’s profile by a text user_id', () => {
+    const card = source('memberCard.service.ts');
+    expect(card).toContain('WHERE user_id = $1::text AND key = ANY($2::text[])');
+    expect(card).toContain('[String(memberId), PROFILE_KEYS, PROFILE_KEYS.length]');
+  });
+
+  it('deletes plan steps by their uuid ids', () => {
+    const chat = source('chat.service.ts');
+    expect(chat).toContain('DELETE FROM conversations WHERE id = ANY($1::uuid[])');
+    expect(chat).not.toContain('DELETE FROM conversations WHERE id = ANY($1::int[])');
+  });
+});
diff --git a/src/services/chat.service.ts b/src/services/chat.service.ts
index 44077b6..4b9eaaa 100644
--- a/src/services/chat.service.ts
+++ b/src/services/chat.service.ts
@@ -4436,7 +4436,7 @@ async function dropPlanStepsTheReplyCarries(
 ): Promise<void> {
   if (!runId || !carriesPlanSentence(reply)) return;
   try {
-    const steps = await query<{ id: number; content: string }>(
+    const steps = await query<{ id: string; content: string }>(
       `SELECT id, content FROM conversations
         WHERE thread_id = $1 AND run_id = $2 AND kind = 'step' AND role = 'assistant'
         ORDER BY id LIMIT $3`,
@@ -4445,7 +4445,12 @@ async function dropPlanStepsTheReplyCarries(
     );
     const ids = steps.rows.filter((s) => carriesPlanSentence(s.content)).map((s) => s.id);
     if (ids.length === 0) return;
-    await query(`DELETE FROM conversations WHERE id = ANY($1::int[])`, [ids], STEP_TIDY_TIMEOUT_MS);
+    // conversations.id is a uuid: as int[] this failed on every call since 9 Oct (ops, 11 Oct).
+    await query(
+      `DELETE FROM conversations WHERE id = ANY($1::uuid[])`,
+      [ids],
+      STEP_TIDY_TIMEOUT_MS,
+    );
     // eslint-disable-next-line no-console
     console.log(`[chat] run ${runId}: dropped ${ids.length} plan step(s) the reply tells again`);
   } catch (error) {
