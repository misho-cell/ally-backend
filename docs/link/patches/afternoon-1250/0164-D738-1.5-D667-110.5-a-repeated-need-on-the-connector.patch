+const ALREADY_OPEN_NEXT =
+  'They already have this goal open. Tell them where it stands rather than opening a second one.';
+/** D738 1.5 (§110.5), word for word. */
+const ALREADY_OPEN_WITH_PLAN_NEXT =
+  'They already have this goal open, with a plan waiting for their yes. Show waiting_plan again ' +
+  'and ask for the yes, rather than opening a second one.';
+
+/**
+ * D738 1.5 (D667): a repeated need finds the goal already open, and when that
+ * goal's plan still waits for the yes, the answer carries it — the app's one
+ * sentence and its question — so the plan is shown again instead of lost.
+ */
+async function waitingPlanOf(taskId: number): Promise<string | null> {
+  try {
+    const task = await getTaskById(taskId);
+    const proposed = task?.plan_proposed ?? null;
+    if (task === null || proposed === null) return null;
+    const language = detectRunLanguage(task.title);
+    return connectorPlanSummary(planInSentences(proposed, language), language);
+  } catch (err) {
+    // eslint-disable-next-line no-console
+    console.warn(`[mcp] goal ${taskId}: the waiting plan was not read:`, (err as Error).message);
+    return null;
+  }
+}
+
 export async function mcpCreateTask(
   userId: string,
   args: { title: string; description?: string; task_type?: string; separate?: boolean },
@@ -1035,16 +1066,18 @@ export async function mcpCreateTask(
   const alreadyOpen =
     args.separate === true ? null : await findOpenTaskNamedIn(userId, title).catch(() => null);
   if (alreadyOpen !== null) {
+    const waitingPlan = await waitingPlanOf(alreadyOpen.id);
     return {
       created: false,
       already_open: {
         task_ref: TASK_REF_PREFIX + String(alreadyOpen.id),
         title: alreadyOpen.title,
         status: alreadyOpen.status,
+        ...(waitingPlan !== null && { waiting_plan: waitingPlan }),
       },
       next:
-        'They already have this goal open. Tell them where it stands rather than opening a ' +
-        'second one. If they say it is a DIFFERENT need, call create_task again with ' +
+        (waitingPlan === null ? ALREADY_OPEN_NEXT : ALREADY_OPEN_WITH_PLAN_NEXT) +
+        ' If they say it is a DIFFERENT need, call create_task again with ' +
         'separate: true and it will be created.',
     };
   }
