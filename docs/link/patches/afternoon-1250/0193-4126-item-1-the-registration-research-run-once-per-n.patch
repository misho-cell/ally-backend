index 0000000..419fab9
--- /dev/null
+++ b/src/services/registrationResearch/plan.ts
@@ -0,0 +1,158 @@
+/**
+ * 4126 item 1 — the pure half of the registration research run: which searches
+ * to make, how far the run may go, and how sure each fact is.
+ *
+ * D757 (Lika + Tornike): a user is researched ONCE, at registration, as deep as
+ * possible. Misho's „შეზღუდე" (§122 scope): with a hard stop per person, so one
+ * common name cannot spend without limit.
+ */
+
+/** Misho's stop, per person (scope item 1). */
+export const MAX_SEARCHES_PER_PERSON = 60;
+export const MAX_PAGES_PER_PERSON = 30;
+
+/** The extractor reads at most this much of one page. */
+export const MAX_PAGE_CHARS = 6_000;
+export const MAX_SNIPPET_CHARS = 600;
+export const MAX_FACT_CHARS = 500;
+
+/** Keys a fact may carry; anything else the extractor returns is dropped. */
+export const RESEARCH_FACT_KEYS: ReadonlySet<string> = new Set([
+  'occupation',
+  'employer',
+  'industry',
+  'city',
+  'education',
+  'affiliation',
+  'expertise',
+  'other_role',
+  'headline',
+]);
+
+/** contact_facts holds one value per saver for these (uq_contact_facts_structured). */
+export const ONE_VALUE_KEYS: ReadonlySet<string> = new Set([
+  'occupation',
+  'employer',
+  'city',
+  'industry',
+]);
+
+export enum FactConfidence {
+  Confirmed = 'confirmed',
+  Possible = 'possible',
+}
+
+export interface FoundFact {
+  readonly key: string;
+  readonly value: string;
+  readonly sources: readonly string[];
+  readonly date: string | null;
+}
+
+export interface StoredFact {
+  readonly key: string;
+  readonly value: string;
+  readonly sourceUrl: string;
+  readonly date: string | null;
+  readonly confidence: FactConfidence;
+  readonly conflictNote: string | null;
+}
+
+/** The first searches for a person: the name alone, then with what they gave at signup. */
+export function firstQueries(name: string, city: string | null): string[] {
+  const person = name.trim();
+  if (person === '') return [];
+  const quoted = `"${person}"`;
+  const queries = [quoted, `${quoted} LinkedIn`, `${quoted} company`, `${quoted} სამსახური`];
+  if (city !== null && city.trim() !== '') queries.splice(1, 0, `${quoted} ${city.trim()}`);
+  return queries.slice(0, MAX_SEARCHES_PER_PERSON);
+}
+
+/** How many more searches the stop allows. */
+export function searchesLeft(spent: number): number {
+  return Math.max(0, MAX_SEARCHES_PER_PERSON - spent);
+}
+
+/** How many more pages the stop allows. */
+export function pagesLeft(spent: number): number {
+  return Math.max(0, MAX_PAGES_PER_PERSON - spent);
+}
+
+const OFFICIAL_HOST_RE = /(?:^|\.)gov(?:\.[a-z]{2})?$|(?:^|\.)gov\.ge$|(?:^|\.)parliament\.ge$/iu;
+const WWW_RE = /^www\./iu;
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/u;
+
+/** The site a source lives on, without „www."; null for anything that is not a URL. */
+export function sourceHost(url: string): string | null {
+  try {
+    return new URL(url).hostname.replace(WWW_RE, '').toLowerCase();
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * D757 §3: source quality, not count, decides. An official source confirms on
+ * its own; otherwise two independent sites do. One ordinary source is
+ * „possible".
+ */
+export function confidenceOf(sources: readonly string[]): FactConfidence {
+  const hosts = new Set(sources.map(sourceHost).filter((h): h is string => h !== null));
+  if ([...hosts].some((h) => OFFICIAL_HOST_RE.test(h))) return FactConfidence.Confirmed;
+  return hosts.size >= 2 ? FactConfidence.Confirmed : FactConfidence.Possible;
+}
+
+/** A fact the store can take: a known key, a value, and at least one real source. */
+export function usableFact(fact: FoundFact): FoundFact | null {
+  const key = fact.key.trim().toLowerCase();
+  const value = fact.value.trim().slice(0, MAX_FACT_CHARS);
+  const sources = fact.sources.filter((url) => sourceHost(url) !== null);
+  if (!RESEARCH_FACT_KEYS.has(key) || value === '' || sources.length === 0) return null;
+  const date = fact.date !== null && DATE_RE.test(fact.date) ? fact.date : null;
+  return { key, value, sources, date };
+}
+
+function strength(fact: FoundFact): number {
+  return (
+    (confidenceOf(fact.sources) === FactConfidence.Confirmed ? 1_000 : 0) + fact.sources.length
+  );
+}
+
+/**
+ * The facts as they will be stored. A one-value key keeps its strongest value;
+ * the others are not dropped silently — the kept fact says what else was found
+ * and where (D757 §3: conflicting sources are both kept and explained).
+ */
+export function factsToStore(found: readonly FoundFact[]): StoredFact[] {
+  const usable = found.map(usableFact).filter((f): f is FoundFact => f !== null);
+  const out: StoredFact[] = [];
+  const byOneValueKey = new Map<string, FoundFact[]>();
+  for (const fact of usable) {
+    if (ONE_VALUE_KEYS.has(fact.key)) {
+      byOneValueKey.set(fact.key, [...(byOneValueKey.get(fact.key) ?? []), fact]);
+    } else {
+      out.push(stored(fact, null));
+    }
+  }
+  for (const facts of byOneValueKey.values()) {
+    const [best, ...others] = [...facts].sort((a, b) => strength(b) - strength(a));
+    const differing = others.filter((o) => o.value.toLowerCase() !== best.value.toLowerCase());
+    const note =
+      differing.length === 0
+        ? null
+        : differing.map((o) => `also found: „${o.value}" (${o.sources[0]})`).join('; ');
+    out.push(stored(best, note));
+  }
+  return out;
+}
+
+function stored(fact: FoundFact, conflictNote: string | null): StoredFact {
+  return {
+    key: fact.key,
+    value: fact.value,
+    sourceUrl: fact.sources[0],
+    date: fact.date,
+    confidence: confidenceOf(fact.sources),
+    conflictNote,
+  };
+}
diff --git a/src/services/registrationResearch/registrationResearch.service.ts b/src/services/registrationResearch/registrationResearch.service.ts
new file mode 100644
index 0000000..13e4c65
--- /dev/null
+++ b/src/services/registrationResearch/registrationResearch.service.ts
@@ -0,0 +1,206 @@
+import { query } from '../../db/postgres/client';
+import { fetchPage, webSearch } from '../tools/webSearch';
+import { extractFacts, PersonGiven, ReadText } from './extract';
+import {
+  factsToStore,
+  firstQueries,
+  MAX_SNIPPET_CHARS,
+  pagesLeft,
+  searchesLeft,
+  sourceHost,
+  StoredFact,
+} from './plan';
+
+/**
+ * 4126 item 1 — one research run per new user, at registration (D757 §5), within
+ * Misho's hard stop.
+ *
+ * OFF until Misho says yes to REGISTRATION_EXTRACT_BRIEF (D44); it also spends
+ * on searches. While off, nothing is queued and the ticker never starts.
+ */
+export const REGISTRATION_RESEARCH_ON = false;
+
+/** The same saver and the same private, unmatchable shape as the Axel research (4225). */
+const SYSTEM_SAVER_ID = '0';
+const RESEARCH_SOURCE = 'research';
+const QUERY_TIMEOUT_MS = 10_000;
+const TICK_INTERVAL_MS = 60_000;
+const MAX_ERROR_CHARS = 300;
+
+/** Queue the new user once; a second call for the same user does nothing. */
+export async function queueRegistrationResearch(
+  userId: number,
+  on: boolean = REGISTRATION_RESEARCH_ON,
+): Promise<boolean> {
+  if (!on) return false;
+  const result = await query(
+    `INSERT INTO registration_research (user_id) VALUES ($1) ON CONFLICT (user_id) DO NOTHING`,
+    [userId],
+    QUERY_TIMEOUT_MS,
+  );
+  return (result.rowCount ?? 0) > 0;
+}
+
+interface Claimed {
+  readonly userId: number;
+  readonly name: string;
+  readonly city: string | null;
+  readonly phones: readonly string[];
+}
+
+/** The oldest queued user, marked running in the same statement so no other tick takes it. */
+async function claimNext(): Promise<Claimed | null> {
+  const result = await query<{ user_id: number; name: string | null; city: string | null }>(
+    `UPDATE registration_research r SET status = 'running', started_at = NOW()
+      WHERE r.user_id = (
+        SELECT user_id FROM registration_research WHERE status = 'queued'
+         ORDER BY queued_at LIMIT 1 FOR UPDATE SKIP LOCKED)
+      RETURNING r.user_id,
+        (SELECT name FROM "User" WHERE id = r.user_id) AS name,
+        (SELECT value FROM user_profile_kv WHERE user_id = r.user_id::text AND key = 'city' LIMIT 1) AS city`,
+    [],
+    QUERY_TIMEOUT_MS,
+  );
+  const row = result.rows[0];
+  if (row === undefined) return null;
+  const phones = await query<{ phone: string }>(
+    `SELECT phone FROM "UserPhone" WHERE "userId" = $1 LIMIT 5`,
+    [row.user_id],
+    QUERY_TIMEOUT_MS,
+  );
+  return {
+    userId: row.user_id,
+    name: (row.name ?? '').trim(),
+    city: row.city,
+    phones: phones.rows.map((p) => p.phone),
+  };
+}
+
+interface Gathered {
+  readonly texts: ReadText[];
+  readonly searches: number;
+  readonly pages: number;
+}
+
+function hitsOf(reply: object): ReadText[] {
+  const raw = (reply as Record<string, unknown>).results;
+  if (!Array.isArray(raw)) return [];
+  return raw.flatMap((hit: unknown) => {
+    const h = hit as Record<string, unknown>;
+    if (typeof h.url !== 'string' || sourceHost(h.url) === null) return [];
+    const text = typeof h.snippet === 'string' ? h.snippet : '';
+    const title = typeof h.title === 'string' ? h.title : null;
+    return [{ url: h.url, title, text: text.slice(0, MAX_SNIPPET_CHARS), isPage: false }];
+  });
+}
+
+/** Searches, then the pages they found, both inside the stop. */
+async function gather(person: PersonGiven): Promise<Gathered> {
+  const snippets: ReadText[] = [];
+  const queries = firstQueries(person.name, person.city).slice(0, searchesLeft(0));
+  for (const q of queries) snippets.push(...hitsOf(await webSearch(q)));
+  const urls = [...new Set(snippets.map((s) => s.url))].slice(0, pagesLeft(0));
+  const pages: ReadText[] = [];
+  for (const url of urls) {
+    const page = (await fetchPage(url)) as Record<string, unknown>;
+    if (typeof page.content === 'string' && page.content.trim() !== '') {
+      pages.push({ url, title: null, text: page.content, isPage: true });
+    }
+  }
+  return { texts: [...snippets, ...pages], searches: queries.length, pages: urls.length };
+}
+
+/** The facts on every number of the user's own; a fact the user removed stays removed. */
+async function storeFacts(
+  phones: readonly string[],
+  facts: readonly StoredFact[],
+): Promise<number> {
+  let stored = 0;
+  for (const phone of phones) {
+    for (const f of facts) {
+      const result = await query(
+        `INSERT INTO contact_facts
+           (neo4j_contact_id, submitted_by_user_id, field_type, value, is_public, source,
+            confidence, is_matchable, source_url, fact_date, research_status, conflict_note)
+         SELECT $1, $2, $3, $4, false, $5, 'mentioned', false, $6, $7::date, $8, $9
+          WHERE NOT EXISTS (
+            SELECT 1 FROM contact_facts
+             WHERE neo4j_contact_id = $1 AND submitted_by_user_id = $2 AND field_type = $3
+               AND (value = $4 OR removed_by_subject_at IS NOT NULL))
+         ON CONFLICT DO NOTHING`,
+        [
+          phone,
+          SYSTEM_SAVER_ID,
+          f.key,
+          f.value,
+          RESEARCH_SOURCE,
+          f.sourceUrl,
+          f.date,
+          f.confidence,
+          f.conflictNote,
+        ],
+        QUERY_TIMEOUT_MS,
+      );
+      stored += result.rowCount ?? 0;
+    }
+  }
+  return stored;
+}
+
+async function finish(
+  userId: number,
+  status: 'done' | 'failed',
+  counts: { searches: number; pages: number; facts: number },
+  error: string | null,
+): Promise<void> {
+  await query(
+    `UPDATE registration_research
+        SET status = $2, searches = $3, pages = $4, facts = $5, error = $6, finished_at = NOW()
+      WHERE user_id = $1`,
+    [userId, status, counts.searches, counts.pages, counts.facts, error],
+    QUERY_TIMEOUT_MS,
+  );
+}
+
+/** One queued user researched; false when nobody was waiting. */
+export async function researchNextUser(): Promise<boolean> {
+  const person = await claimNext();
+  if (person === null) return false;
+  const counts = { searches: 0, pages: 0, facts: 0 };
+  try {
+    if (person.name === '' || person.phones.length === 0) {
+      await finish(person.userId, 'done', counts, 'no name or number to research');
+      return true;
+    }
+    const given = { name: person.name, city: person.city };
+    const gathered = await gather(given);
+    counts.searches = gathered.searches;
+    counts.pages = gathered.pages;
+    const facts = factsToStore(await extractFacts(person.userId, given, gathered.texts));
+    counts.facts = await storeFacts(person.phones, facts);
+    await finish(person.userId, 'done', counts, null);
+    // eslint-disable-next-line no-console
+    console.log(
+      `[registration-research] user ${person.userId}: ${counts.searches} searches, ` +
+        `${counts.pages} pages, ${counts.facts} facts`,
+    );
+  } catch (err) {
+    const message = (err as Error).message.slice(0, MAX_ERROR_CHARS);
+    // eslint-disable-next-line no-console
+    console.error(`[registration-research] user ${person.userId} failed:`, message);
+    await finish(person.userId, 'failed', counts, message);
+  }
+  return true;
+}
+
+/** The ticker: one user a minute, and only while the run is on. */
+export function startRegistrationResearch(on: boolean = REGISTRATION_RESEARCH_ON): boolean {
+  if (!on) return false;
+  setInterval(() => {
+    void researchNextUser().catch((err: unknown) =>
+      // eslint-disable-next-line no-console
+      console.error('[registration-research] tick failed:', (err as Error).message),
+    );
+  }, TICK_INTERVAL_MS).unref();
+  return true;
+}
