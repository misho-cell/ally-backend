@@ -0,0 +1,19 @@
+-- 4126 item 3 (D757 point 2; Misho's yes §133): people found on public member
+-- lists, whom no user may know. Only what the list itself says: name,
+-- organisation, the listed role, where and when it was read. No phone and no
+-- photo. Such a person is never a „knows" link and never an introduction route.
+-- matched_phone is set only by the same-name check (listPeople.service.ts),
+-- and only when it leaves no doubt; on doubt the row stays unmerged.
+CREATE TABLE IF NOT EXISTS list_people (
+  id            SERIAL PRIMARY KEY,
+  name          TEXT NOT NULL CHECK (length(trim(name)) > 0),
+  organisation  TEXT NOT NULL CHECK (length(trim(organisation)) > 0),
+  listed_role   TEXT,
+  source_url    TEXT NOT NULL CHECK (source_url ~ '^https?://'),
+  checked_on    DATE NOT NULL,
+  matched_phone TEXT,
+  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS list_people_once_idx
+  ON list_people (lower(name), lower(organisation), source_url);
diff --git a/src/services/__tests__/aListMemberIsNotAnAcquaintance.test.ts b/src/services/__tests__/aListMemberIsNotAnAcquaintance.test.ts
new file mode 100644
index 0000000..7d170e2
--- /dev/null
+++ b/src/services/__tests__/aListMemberIsNotAnAcquaintance.test.ts
@@ -0,0 +1,94 @@
+jest.mock('../../db/postgres/client', () => ({ __esModule: true, query: jest.fn() }));
+
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { query } from '../../db/postgres/client';
+import {
+  ListPerson,
+  sameNamePerson,
+  storeListPerson,
+  usableListPerson,
+} from '../listPeople.service';
+
+/**
+ * 4126 item 3 (D757 point 2; Misho's yes §133): people from public member
+ * lists, apart from contacts — name, organisation, role, source and date only.
+ */
+const mockQuery = query as jest.MockedFunction<typeof query>;
+
+const ENTRY: ListPerson = {
+  name: '  Nino  Beridze ',
+  organisation: 'Georgian Bar Association',
+  listedRole: 'member',
+  sourceUrl: 'https://gba.ge/members',
+  checkedOn: '2026-10-12',
+};
+
+beforeEach(() => mockQuery.mockReset());
+
+describe('what an entry may hold', () => {
+  it('keeps the five fields, spaces tidied', () => {
+    expect(usableListPerson(ENTRY)).toEqual({ ...ENTRY, name: 'Nino Beridze' });
+  });
+
+  it('refuses an entry without a real source or date', () => {
+    expect(usableListPerson({ ...ENTRY, sourceUrl: 'gba.ge' })).toBeNull();
+    expect(usableListPerson({ ...ENTRY, checkedOn: '12 Oct' })).toBeNull();
+    expect(usableListPerson({ ...ENTRY, organisation: ' ' })).toBeNull();
+  });
+
+  it('has no column for a phone of its own or a photo, and is no route', () => {
+    const migration = readFileSync(
+      join(__dirname, '..', '..', 'db', 'postgres', 'migrations', '238_list_people.sql'),
+      'utf8',
+    );
+    const columns = migration
+      .split('\n')
+      .filter((line) => !line.trim().startsWith('--'))
+      .join('\n');
+    expect(columns).not.toMatch(/photo|avatar|\bphone\s+TEXT/iu);
+    expect(migration).toContain('never a „knows" link and never an introduction route');
+  });
+});
+
+describe('the same-name check', () => {
+  const nino = {
+    phone: '+995599000001',
+    name: 'nino beridze',
+    organisations: ['Georgian Bar Association'],
+  };
+
+  it('joins one known person with the same name and the same organisation', () => {
+    expect(sameNamePerson(ENTRY, [nino])).toBe('+995599000001');
+  });
+
+  it('leaves it unmerged on a shared name alone', () => {
+    expect(sameNamePerson(ENTRY, [{ ...nino, organisations: ['TBC Bank'] }])).toBeNull();
+  });
+
+  it('leaves it unmerged when two people fit', () => {
+    expect(sameNamePerson(ENTRY, [nino, { ...nino, phone: '+995599000002' }])).toBeNull();
+  });
+});
+
+describe('storeListPerson', () => {
+  it('stores a usable entry once, with its match', async () => {
+    mockQuery.mockResolvedValue({ rows: [], rowCount: 1 } as never);
+    await expect(storeListPerson(ENTRY, null)).resolves.toBe(true);
+    const [sql, params] = mockQuery.mock.calls[0];
+    expect(sql).toContain('ON CONFLICT DO NOTHING');
+    expect(params).toEqual([
+      'Nino Beridze',
+      'Georgian Bar Association',
+      'member',
+      'https://gba.ge/members',
+      '2026-10-12',
+      null,
+    ]);
+  });
+
+  it('writes nothing for a malformed entry', async () => {
+    await expect(storeListPerson({ ...ENTRY, sourceUrl: 'x' }, null)).resolves.toBe(false);
+    expect(mockQuery).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/services/listPeople.service.ts b/src/services/listPeople.service.ts
new file mode 100644
index 0000000..7fbcb09
--- /dev/null
+++ b/src/services/listPeople.service.ts
@@ -0,0 +1,98 @@
+import { query } from '../db/postgres/client';
+
+/**
+ * 4126 item 3 (D757 point 2; Misho's yes §133): people found on public member
+ * lists, kept apart from contacts and users. A list says who belongs to an
+ * organisation, never who knows whom: nothing here is a „knows" link or an
+ * introduction route, and a row joins a known person only when the same-name
+ * check below leaves no doubt.
+ */
+const MAX_NAME_CHARS = 200;
+const MAX_ORGANISATION_CHARS = 200;
+const MAX_ROLE_CHARS = 200;
+const MAX_URL_CHARS = 1_000;
+const QUERY_TIMEOUT_MS = 5_000;
+const URL_RE = /^https?:\/\/\S+$/u;
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/u;
+const SPACES_RE = /\s+/gu;
+
+export interface ListPerson {
+  readonly name: string;
+  readonly organisation: string;
+  readonly listedRole: string | null;
+  readonly sourceUrl: string;
+  /** YYYY-MM-DD, the day the list was read. */
+  readonly checkedOn: string;
+}
+
+/** A known person the list entry might be: their number, name, and the organisations on record. */
+export interface KnownPerson {
+  readonly phone: string;
+  readonly name: string;
+  readonly organisations: readonly string[];
+}
+
+function plain(text: string): string {
+  return text.trim().replace(SPACES_RE, ' ').toLocaleLowerCase();
+}
+
+/** The entry as it may be stored, or null when a field is missing or malformed. */
+export function usableListPerson(person: ListPerson): ListPerson | null {
+  const name = person.name.trim().replace(SPACES_RE, ' ');
+  const organisation = person.organisation.trim().replace(SPACES_RE, ' ');
+  const role = person.listedRole?.trim() ?? '';
+  const url = person.sourceUrl.trim();
+  if (name === '' || name.length > MAX_NAME_CHARS) return null;
+  if (organisation === '' || organisation.length > MAX_ORGANISATION_CHARS) return null;
+  if (!URL_RE.test(url) || url.length > MAX_URL_CHARS) return null;
+  if (!DATE_RE.test(person.checkedOn)) return null;
+  return {
+    name,
+    organisation,
+    listedRole: role === '' ? null : role.slice(0, MAX_ROLE_CHARS),
+    sourceUrl: url,
+    checkedOn: person.checkedOn,
+  };
+}
+
+/**
+ * The same-name check. The entry joins a known person only when exactly one
+ * candidate has the same full name AND the same organisation on record; a
+ * shared name alone, or two such candidates, leaves it unmerged.
+ */
+export function sameNamePerson(
+  person: ListPerson,
+  candidates: readonly KnownPerson[],
+): string | null {
+  const name = plain(person.name);
+  const organisation = plain(person.organisation);
+  const matches = candidates.filter(
+    (c) => plain(c.name) === name && c.organisations.some((o) => plain(o) === organisation),
+  );
+  const phones = new Set(matches.map((c) => c.phone));
+  return phones.size === 1 ? [...phones][0] : null;
+}
+
+/** Stores one entry once; true when it is new. A malformed entry is refused. */
+export async function storeListPerson(
+  person: ListPerson,
+  matchedPhone: string | null,
+): Promise<boolean> {
+  const usable = usableListPerson(person);
+  if (usable === null) return false;
+  const result = await query(
+    `INSERT INTO list_people (name, organisation, listed_role, source_url, checked_on, matched_phone)
+     VALUES ($1, $2, $3, $4, $5::date, $6)
+     ON CONFLICT DO NOTHING`,
+    [
+      usable.name,
+      usable.organisation,
+      usable.listedRole,
+      usable.sourceUrl,
+      usable.checkedOn,
+      matchedPhone,
+    ],
+    QUERY_TIMEOUT_MS,
+  );
+  return (result.rowCount ?? 0) > 0;
+}
