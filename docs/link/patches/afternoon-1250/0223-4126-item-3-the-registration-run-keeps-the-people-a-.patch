+
+    expect(await researchNextUser(true)).toBe(true);
+    expect(mockExtract).not.toHaveBeenCalled();
+    const listed = mockQuery.mock.calls.find((c) => sqlOf(c).includes('INSERT INTO list_people'));
+    expect(listed?.[1]).toEqual([
