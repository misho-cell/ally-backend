@@ -0,0 +1,27 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { runLatencyLine } from '../runLatency';
+
+/** 958: the seconds around the run, split per answer, with no guessing. */
+describe('the latency line', () => {
+  it('splits stored→run and run→answer and gives the total', () => {
+    expect(runLatencyLine('r1', 50756, 1_000, 3_100, 4_380)).toBe(
+      '[latency] run r1 thread 50756: stored→run 2100 ms, run→answer 1280 ms, total 3380 ms',
+    );
+  });
+
+  it('is written when the answer is handed to the app, for runs that carry a stored time', () => {
+    const route = readFileSync(
+      join(__dirname, '..', '..', 'api', 'routes', 'threads.routes.ts'),
+      'utf8',
+    );
+    expect(route).toContain('const storedAt = Date.now();');
+    const line = route.indexOf('runLatencyLine(runId, threadId, storedAt');
+    const emit = route.indexOf(
+      'emitRunComplete(userId, threadId, runId, {\n        reply: result.reply,',
+    );
+    expect(line).toBeGreaterThan(-1);
+    expect(line).toBeLessThan(emit);
+    expect(route).toContain('if (storedAt !== undefined) {');
+  });
+});
diff --git a/src/services/runLatency.ts b/src/services/runLatency.ts
new file mode 100644
index 0000000..24325d6
--- /dev/null
+++ b/src/services/runLatency.ts
@@ -0,0 +1,20 @@
+/**
+ * 958 (the tester's 55870 re-run, 12 Oct 23:29Z): small talk took 5.5–6.5 s
+ * end to end while the model run itself took 1.6–2.7 s. In the database the
+ * owner's stored message and the stored reply were 3.6–4.7 s apart, and the
+ * ~2 s around the run was logged nowhere. This line splits it, per answer:
+ * from the stored message to the run's start (the thread queue, the route),
+ * and from the run's start to the answer handed to the app.
+ */
+export function runLatencyLine(
+  runId: string,
+  threadId: number,
+  storedAt: number,
+  runStartedAt: number,
+  answeredAt: number,
+): string {
+  return (
+    `[latency] run ${runId} thread ${threadId}: stored→run ${runStartedAt - storedAt} ms, ` +
+    `run→answer ${answeredAt - runStartedAt} ms, total ${answeredAt - storedAt} ms`
+  );
+}
