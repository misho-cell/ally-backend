---
 .../__tests__/aQuestionSavesNothing.test.ts      | 16 ++++++++++++++++
 src/services/savedClaim.ts                       |  7 ++++++-
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/src/services/__tests__/aQuestionSavesNothing.test.ts b/src/services/__tests__/aQuestionSavesNothing.test.ts
index 1f5550a..a49fbae 100644
--- a/src/services/__tests__/aQuestionSavesNothing.test.ts
+++ b/src/services/__tests__/aQuestionSavesNothing.test.ts
@@ -33,6 +33,22 @@ describe('an „I saved" sentence under a plain question', () => {
     expect(withoutSavedClaimOnAQuestion('შევინახე.', asked, [])).toBe('შევინახე.');
   });
 
+  it.each([
+    [
+      'ბახვა ძველაძე ადრე თიბისი ბანკში მუშაობდა. ახლა ვისოლშია.\n\nვინახავ: ბახვა ძველაძე, სამუშაო ადგილი: ვისოლი.',
+      'ბახვა ძველაძე ადრე თიბისი ბანკში მუშაობდა. ახლა ვისოლშია.',
+    ],
+    ['ბახვა ვისოლშია. დავიმახსოვრებ.', 'ბახვა ვისოლშია.'],
+    ["Bakhva works at Visol. I'll save that.", 'Bakhva works at Visol.'],
+  ])('takes out the present and future tense too (tester 56531): „%s"', (reply, kept) => {
+    expect(withoutSavedClaimOnAQuestion(reply, 'ვინ მუშაობდა ადრე თიბისი ბანკში?', [])).toBe(kept);
+  });
+
+  it('leaves a line about the owner saving alone', () => {
+    const reply = 'ბახვა ვისოლშია. თუ გინდა, ნომერს შეინახავ?';
+    expect(withoutSavedClaimOnAQuestion(reply, asked, [])).toBe(reply);
+  });
+
   it('runs on every reply the owner reads', () => {
     const chat = readFileSync(join(__dirname, '..', 'chat.service.ts'), 'utf8');
     expect(chat).toContain('finalText = withoutSavedClaimOnAQuestion(');
diff --git a/src/services/savedClaim.ts b/src/services/savedClaim.ts
index 1bcea3b..2b66665 100644
--- a/src/services/savedClaim.ts
+++ b/src/services/savedClaim.ts
@@ -6,8 +6,13 @@
  * the answer itself stays. Only the first-person verbs: „შენახულია" (it is
  * saved) can be a true account of an earlier save.
  */
+/**
+ * 4491's side note (tester 56531): „ვინახავ: ბახვა, სამუშაო ადგილი: ვისოლი." under
+ * a plain question — the same false claim in the present tense, which the past
+ * forms let through. The present and future first person count too.
+ */
 const SAID_SAVED_RE =
-  /(?<![\p{L}\p{M}])(?:დავიმახსოვრე|შევინახე|ჩავიწერე|I(?:'ve| have)? saved|I(?:'ve| have)? noted|сохранил[аи]?|запомнил[аи]?|guardé)(?![\p{L}\p{M}])/iu;
+  /(?<![\p{L}\p{M}])(?:დავიმახსოვრე|შევინახე|ჩავიწერე|ვინახავ|შევინახავ|დავიმახსოვრებ|ვიმახსოვრებ|ჩავიწერ|I(?:'ve| have| am|'m|'ll| will)? (?:saved|saving|save|noted|noting|note)|сохранил[аи]?|сохраняю|запомнил[аи]?|запомню|guardé|guardo)(?![\p{L}\p{M}])/iu;
 const SAVING_TOOL_RE = /^(?:save_|correct_|remember_|add_|set_user_|update_profile)/u;
 const QUESTION_RE = /[?？]\s*$/u;
 /** A sentence ends at . ! ? or a line break; the mark stays with its sentence. */
