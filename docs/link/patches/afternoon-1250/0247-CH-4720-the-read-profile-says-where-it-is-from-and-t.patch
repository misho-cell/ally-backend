From 343dc7a68e83b16ec613ff0574ce9d4a2f36f597 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 11:48:00 +0000
Subject: [PATCH 247/248] CH (4720): the read profile says where it is from and
 the day it was read
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Misho's yes, 13 Oct 11:2x UTC in the operations chat („ჩემგან ყველაფერზე
კია", relayed verbatim by ops at 11:28Z), to the sentence in the morning
list. The tester's 56073: public-profile facts were given in the run's own
words 3 of 3, but with no date and once as a bare link. The server already
handed over the URL and the day it was read; nothing told the model to say
them. The public_profile page now carries a note, word for word: „When you
use public_profile, say where it is from and the day it was read (e.g.
„LinkedIn, read 13 Oct"); never a bare link."

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 .../aPublicProfileIsReadNotLinked.test.ts       | 17 ++++++++++++++++-
 src/services/tools/publicProfileRead.ts         | 16 +++++++++++++++-
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/services/tools/__tests__/aPublicProfileIsReadNotLinked.test.ts b/src/services/tools/__tests__/aPublicProfileIsReadNotLinked.test.ts
index f70c6b8..a543501 100644
--- a/src/services/tools/__tests__/aPublicProfileIsReadNotLinked.test.ts
+++ b/src/services/tools/__tests__/aPublicProfileIsReadNotLinked.test.ts
@@ -1,4 +1,9 @@
-import { profilePage, profileUrlIn, withPublicProfile } from '../publicProfileRead';
+import {
+  PUBLIC_PROFILE_NOTE,
+  profilePage,
+  profileUrlIn,
+  withPublicProfile,
+} from '../publicProfileRead';
 
 /**
  * 4720 (box 54881): the search found the person's public LinkedIn page and the
@@ -36,6 +41,7 @@ describe('withPublicProfile', () => {
         url: PROFILE,
         read_on: '2026-10-12',
         content: 'Head of Sales at Wissol since 2023',
+        note: PUBLIC_PROFILE_NOTE,
       },
     });
     expect(read).toHaveBeenCalledTimes(1);
@@ -67,3 +73,12 @@ describe('withPublicProfile', () => {
     expect(page?.content).toHaveLength(6_000);
   });
 });
+
+/** CH (4720, the tester's 56073): no date and once a bare link. Misho's yes, §139. */
+describe('the note that rides with the page', () => {
+  it('is Misho’s sentence word for word', () => {
+    expect(PUBLIC_PROFILE_NOTE).toBe(
+      'When you use public_profile, say where it is from and the day it was read (e.g. „LinkedIn, read 13 Oct"); never a bare link.',
+    );
+  });
+});
diff --git a/src/services/tools/publicProfileRead.ts b/src/services/tools/publicProfileRead.ts
index a035b63..b393211 100644
--- a/src/services/tools/publicProfileRead.ts
+++ b/src/services/tools/publicProfileRead.ts
@@ -14,10 +14,19 @@ const PROFILE_URL_RE = /^https?:\/\/(?:[a-z]{2,3}\.)?linkedin\.com\/in\/[^/?#\s]
 const TOP_RESULTS_LOOKED_AT = 3;
 const MAX_PROFILE_CHARS = 6_000;
 
+/**
+ * CH (4720, the tester's 56073: facts given 3 of 3, but no date and once a bare
+ * link). MODEL-FACING (D44): Misho's yes word for word, 13 Oct 11:2x UTC in the
+ * operations chat, „ჩემგან ყველაფერზე კია" (§139). It rides with the page.
+ */
+export const PUBLIC_PROFILE_NOTE =
+  'When you use public_profile, say where it is from and the day it was read (e.g. „LinkedIn, read 13 Oct"); never a bare link.';
+
 export interface PublicProfilePage {
   readonly url: string;
   readonly read_on: string;
   readonly content: string;
+  readonly note: string;
 }
 
 type PageReader = (url: string) => Promise<object>;
@@ -42,7 +51,12 @@ export function profileUrlIn(found: object): string | null {
 export function profilePage(url: string, page: object, today: string): PublicProfilePage | null {
   const content = (page as Record<string, unknown>).content;
   if (typeof content !== 'string' || content.trim() === '') return null;
-  return { url, read_on: today, content: content.slice(0, MAX_PROFILE_CHARS) };
+  return {
+    url,
+    read_on: today,
+    content: content.slice(0, MAX_PROFILE_CHARS),
+    note: PUBLIC_PROFILE_NOTE,
+  };
 }
 
