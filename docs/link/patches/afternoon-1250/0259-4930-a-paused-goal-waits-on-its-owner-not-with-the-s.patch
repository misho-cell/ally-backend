 const GOAL_IS_FINISHED = `(${HAS_A_GOAL} AND NOT ${HAS_OPEN_GOAL})`;
+/**
+ * 4930 (Giorgi, 13 Oct): a PAUSED goal was „finished": its thread read
+ * `done` (5 of the 6 paused goals of the last 30 days) and sat with the solved
