From cd50ae85567049a60f287170d2a19169659fb6ac Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 08:14:11 +0000
Subject: [PATCH] 4655: own part only, on again; 56802's leak was the server's
 own send
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The tester's 56802 (13 Oct 13:03Z) found Gela's message carrying Levan's
introduction 2 of 2 with CG on, and CG was switched off under D710. The
two ask rows show where that message came from: written 1-2 s after the
owner's line, by sendInstructedAsk, which took the whole rest of the
sentence („…, და ლევანს სთხოვე, გამაცნოს ნინო."). The model never wrote
it. Since 0256 that path sends nothing for a sentence that holds an
introduction, and the own-part check refuses both of 56802's messages
(pinned now). With the check off, the question to Gela is refused as an
introduction, so 4655 cannot pass at all; on, Gela gets her own part and
Levan gets the introduction.

Model-facing text unchanged: OTHER_PART_REFUSAL as approved (§139, CG).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 .../eachPersonGetsOnlyTheirOwnPart.test.ts    | 32 ++++++++++++++++---
 src/services/introInstruction.ts              | 11 +++++--
 2 files changed, 36 insertions(+), 7 deletions(-)

diff --git a/src/services/__tests__/eachPersonGetsOnlyTheirOwnPart.test.ts b/src/services/__tests__/eachPersonGetsOnlyTheirOwnPart.test.ts
index 5161bee..6410c71 100644
--- a/src/services/__tests__/eachPersonGetsOnlyTheirOwnPart.test.ts
+++ b/src/services/__tests__/eachPersonGetsOnlyTheirOwnPart.test.ts
@@ -1,22 +1,46 @@
-import { askIsTheIntroduction, OWN_PART_ONLY_ON } from '../introInstruction';
+import { contactInstructionIn } from '../instructionUnsent';
+import {
+  askIsTheIntroduction,
+  ownerAsksForIntroduction,
+  OWN_PART_ONLY_ON,
+} from '../introInstruction';
 import { OTHER_PART_REFUSAL, questionCarriesAnotherPart } from '../ownPart';
 
 /**
  * 4655 rebuilt (the tester's 55954 and 56014). One sentence, two requests: the
  * question to Gela goes, but carries only Gela's part — never Levan's
- * introduction. OFF until Misho's yes on the refusal sentence.
+ * introduction. ON (Misho's yes on the refusal sentence, §139), off under D710
+ * on 13 Oct, on again 14 Oct once 56802's leak was traced to the server's own send.
  */
 const OWNER = ['გელას ჰკითხე, ხომ არ იცის კარგი სანტექნიკოსი, და ლევანს სთხოვე, გამაცნოს ნინო.'];
 const GELA = 'გელა გამოგონილი';
 const LEVAN = 'ლევან საცდელი';
 
 describe('each person gets only their own part (4655)', () => {
-  it('is OFF again (D710, 56802); with the split off, the guard behaves as before', () => {
-    expect(OWN_PART_ONLY_ON).toBe(false);
+  it('is ON: with the split off, Gela’s question would be refused as an introduction', () => {
+    expect(OWN_PART_ONLY_ON).toBe(true);
     expect(askIsTheIntroduction(OWNER, GELA, false)).toBe(true);
     expect(questionCarriesAnotherPart(OWNER, GELA, 'და ლევანმა გააცნოს ნინო', false)).toBe(false);
   });
 
+  /**
+   * 56802 (13 Oct 13:03Z): both of Gela's messages carried Levan's part. They were
+   * written by the server's own send, not the model; this check refuses both, and
+   * the server's send now sends nothing for a sentence that holds an introduction.
+   */
+  it.each([
+    'გაეცანი: კარგ სანტექნიკოსს ხომ არ იცნობ? ასევე, ტესტ ორი თხოვნა-ს უნდა, რომ ლევანმა ნინოს გააცნოს.',
+    'კარგ სანტექნიკოსს ხომ არ იცნობ? ასევე, შეგიძლია ლევანს სთხოვო, ნინოს გააცნოს ის?',
+  ])('refuses 56802’s leaked message: „%s"', (question) => {
+    expect(questionCarriesAnotherPart(OWNER, GELA, question, true)).toBe(true);
+  });
+
+  it('the server’s own send stands back from the two-request sentence (0256)', () => {
+    const sentence = contactInstructionIn(OWNER[0]);
+    expect(sentence).not.toBeNull();
+    expect(ownerAsksForIntroduction([sentence ?? ''])).toBe(true);
+  });
+
   it('with the split on, the question to Gela is a question', () => {
     expect(askIsTheIntroduction(OWNER, GELA, true)).toBe(false);
     expect(askIsTheIntroduction(OWNER, LEVAN, true)).toBe(true);
diff --git a/src/services/introInstruction.ts b/src/services/introInstruction.ts
index a1572c4..9ba1dcf 100644
--- a/src/services/introInstruction.ts
+++ b/src/services/introInstruction.ts
@@ -52,9 +52,14 @@ function nameStem(name: string): string | null {
  * ON since Misho's yes on that check's refusal sentence (CG), 13 Oct 11:2x UTC
  * in the operations chat, „ჩემგან ყველაფერზე კია" (§139).
  */
-// OFF again (D710), 13 Oct 14:1xZ: the tester's 56802 found Gela's message still
-// carrying Levan's introduction 2 of 2 with it on — the leak the check exists to stop.
-export const OWN_PART_ONLY_ON = false;
+// OFF (D710) 13 Oct 14:1xZ, then ON again 14 Oct: the tester's 56802 found Gela's
+// message carrying Levan's introduction 2 of 2, but that message was never the
+// model's. task_asks shows it written 1–2 s after the owner's line, by the server's
+// own send (instructedAsk), which took the whole rest of the sentence. That path
+// has sent nothing for a sentence holding an introduction since 0256. This check
+// catches both of 56802's messages. With it off, the question to Gela is refused
+// as an introduction, so 4655 can only pass with it on.
+export const OWN_PART_ONLY_ON = true;
 const PART_BREAK_RE = /;\s*|,\s*(?:და|ასევე|and|also)\s+/iu;
 
 /** The owner's words cut into each person's part (sentences, and parts when split). */
