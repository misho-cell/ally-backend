From e82a51296846040e5f1db85c723d9b91514ac32d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 08:18:43 +0000
Subject: [PATCH] 3106: a weather question looks for nobody in the phonebook
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The tester's re-run (13 Oct 01:50Z, seats 183717-183719): „დღეს რა
ამინდია თბილისში?" sent as a goal ran search_by_tag:way_in beside
web_search on every run, 18.9-21.3 s against a 12 s target. A weather
page's title handed the way-in lookup „Weather" and „ამინდი" to search
the owner's contacts for.

A weather run (asksTheWeather, the same check that forces its web
search) now starts no opening search and its web_search skips the
way-in lookup. The weather is still looked up on the web.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 .../theWeatherLooksForNobody.test.ts          | 36 +++++++++++++++++++
 src/services/chat.service.ts                  | 16 +++++++--
 2 files changed, 50 insertions(+), 2 deletions(-)
 create mode 100644 src/services/__tests__/theWeatherLooksForNobody.test.ts

diff --git a/src/services/__tests__/theWeatherLooksForNobody.test.ts b/src/services/__tests__/theWeatherLooksForNobody.test.ts
new file mode 100644
index 0000000..5cd0dbb
--- /dev/null
+++ b/src/services/__tests__/theWeatherLooksForNobody.test.ts
@@ -0,0 +1,36 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { needsNoOpeningSearch } from '../goalIntent';
+import { asksTheWeather } from '../smallTalk';
+
+/**
+ * 3106, the weather half (re-run 13 Oct 01:50Z, seats 183717–183719): „დღეს რა
+ * ამინდია თბილისში?" sent as a goal ran search_by_tag:way_in beside web_search
+ * on every run. A weather page's title handed the phonebook lookup „Weather" and
+ * „ამინდი". Nobody is looked for in a weather question.
+ */
+const TESTERS_LINE = 'დღეს რა ამინდია თბილისში?';
+const source = readFileSync(join(__dirname, '..', 'chat.service.ts'), 'utf8');
+
+describe('a weather question looks for nobody (3106)', () => {
+  it('reads the tester’s line as a weather question, which the old opening rule did not', () => {
+    expect(asksTheWeather(TESTERS_LINE)).toBe(true);
+    expect(needsNoOpeningSearch(TESTERS_LINE)).toBe(false);
+  });
+
+  it('opens no opening search on a weather question', () => {
+    expect(source).toContain(
+      'autoGoalId === null || needsNoOpeningSearch(userMessage) || asksTheWeather(userMessage)',
+    );
+  });
+
+  it('marks the weather run and skips the way-in lookup on its web search', () => {
+    expect(source).toContain('if (weatherLookUp) runLooksUpTheWeather.add(runId);');
+    expect(source).toContain('runId !== undefined && runLooksUpTheWeather.has(runId)');
+    expect(source).toContain('runLooksUpTheWeather.delete(runId);');
+  });
+
+  it('still looks the weather up on the web', () => {
+    expect(source).toContain('...(weatherLookUp && { forceTool: WEB_SEARCH_TOOL })');
+  });
+});
diff --git a/src/services/chat.service.ts b/src/services/chat.service.ts
index c7d3c5d..863fd24 100644
--- a/src/services/chat.service.ts
+++ b/src/services/chat.service.ts
@@ -5585,6 +5585,13 @@ async function offerNotedOpenAsksCard(runId: string): Promise<void> {
 const runIntroSent = new Set<string>();
 /** The tester's 1149 (38149, 38157): runs whose own web search came back with results. */
 const runWebFound = new Set<string>();
+/**
+ * 3106 (the weather half, re-run 13 Oct 01:50Z): runs that look up the weather. A
+ * weather page's title gave the way-in lookup „Weather" and „ამინდი" to search the
+ * owner's phonebook for, on every run, while the reply waited. Nobody is looked for
+ * in a weather question, so it searches the web and nothing else.
+ */
+const runLooksUpTheWeather = new Set<string>();
 /** #893: the labels of the list this run worked, for the check that the reply names every row. */
 const runListLabels = new Map<string, string[]>();
 /** The tool names this many rows to the model; a longer list is not checked row by row. */
@@ -8849,6 +8856,7 @@ function clearRunState(runId: string): void {
   runMembersFound.delete(runId);
   runIntroSent.delete(runId);
   runWebFound.delete(runId);
+  runLooksUpTheWeather.delete(runId);
   runListLabels.delete(runId);
   runAnswerSent.delete(runId);
   runAskSent.delete(runId);
@@ -9260,7 +9268,10 @@ async function executeToolCall(
        * the model has them at the moment it is deciding what to say about
        * each firm rather than in a section it read a minute ago.
        */
-      const waysIn = await findWaysIn(userId, webResultNames(found), { threadId, runId });
+      const waysIn =
+        runId !== undefined && runLooksUpTheWeather.has(runId)
+          ? new Map<string, WayIn>()
+          : await findWaysIn(userId, webResultNames(found), { threadId, runId });
       noteWaysIn(runId, withoutNamesakes(String(input['query'] ?? ''), waysIn));
       if (waysIn.size === 0) return found;
       return {
@@ -13184,6 +13195,7 @@ async function runToolLoop(
     !ownerAbsent &&
     asksTheWeather(lastOwnerText(messages) ?? '') &&
     tools.some((tool) => tool.name === WEB_SEARCH_TOOL);
+  if (weatherLookUp) runLooksUpTheWeather.add(runId);
   let options: DisambiguationCandidate[] | undefined;
   let choices: string[] | undefined;
   // 2971: every step bubble the owner saw, so a question said only there is not lost.
@@ -15850,7 +15862,7 @@ export async function processChat(
    * VIN.GE, and told the owner it had found them a contact there.
    */
   const lateSearch =
-    autoGoalId === null || needsNoOpeningSearch(userMessage)
+    autoGoalId === null || needsNoOpeningSearch(userMessage) || asksTheWeather(userMessage)
       ? null
       : startOpeningSearches(userId, userMessage, runId, threadId);
   // #397: the opening searches are the run's first search; the line says so.
-- 
