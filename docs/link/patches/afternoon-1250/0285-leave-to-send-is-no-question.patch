     );
     expect(chat).toMatch(/!claimedAnAskNobodyGot &&\s+!introductionQuestion &&/u);
   });
diff --git a/src/services/chat.service.ts b/src/services/chat.service.ts
index 738c045..9dc4215 100644
--- a/src/services/chat.service.ts
+++ b/src/services/chat.service.ts
@@ -465,6 +465,7 @@ import { noContactsYetSection } from './noContactsYet';
 import { withoutNoteTalk } from './noteTalk';
 import {
   askIsTheIntroduction,
+  asksLeaveToSend,
   OWN_PART_ONLY_ON,
   ownerAsksForIntroduction,
   USE_INTRODUCTION_REFUSAL,
@@ -13915,8 +13916,11 @@ async function runToolLoop(
   // 3697 (F20, 10 of 10): „ask Maia to introduce me to Bakhva" with no reason —
   // the run asked the owner why. That is a real question, and an introduction
   // is not an ask this guard can send; replacing it with „not sent" lost it.
+  // 0266 part 1 (58043): but a question asking LEAVE to send is no question — the line was the yes.
   const introductionQuestion =
-    ownerAsksForIntroduction([runOwnerLine.get(runId) ?? '']) && endsWithQuestion(finalText);
+    ownerAsksForIntroduction([runOwnerLine.get(runId) ?? '']) &&
+    endsWithQuestion(finalText) &&
+    !asksLeaveToSend(finalText);
   const instructionUnsent =
     !ownerAbsent &&
     !promoted &&
diff --git a/src/services/introInstruction.ts b/src/services/introInstruction.ts
index 9ba1dcf..499a36c 100644
--- a/src/services/introInstruction.ts
+++ b/src/services/introInstruction.ts
@@ -21,6 +21,23 @@ export function ownerAsksForIntroduction(ownerLines: readonly string[]): boolean
   return ownerLines.some((line) => OWNER_INTRO_RE.test(line));
 }
 
+/**
+ * 0266 part 1 (the tester's 58043, run 51403): „სთხოვე ზურაბს, დამაკავშიროს
+ * თამართან" was answered „…მივწერო ზურაბს და სთხოვო, დაგაკავშიროთ?" and nothing
+ * went. A question back after an introduction instruction is let stand when it
+ * asks for the REASON (3697); one asking LEAVE to send is not a real question,
+ * because the typed instruction is itself that yes (CF, §139).
+ */
+const ASKS_LEAVE_TO_SEND_RE =
+  /(?:მივწერო|მივწერ|გავუგზავნო|გავაგზავნო|ვთხოვო|ვკითხო|მივმართო|დავუკავშირდე)(?!\p{L})|\b(?:shall|should)\s+i\s+(?:send|write|ask|message|contact)\b|\b(?:want|like)\s+me\s+to\s+(?:send|write|ask|message|contact)\b|(?:написать|отправить|попросить)\s+(?:ему|ей|им)?\s*\?|(?:quieres|deseas)\s+que\s+(?:le\s+)?(?:escriba|envíe|pida)/iu;
+
+/** True when the reply's last question asks the owner for leave to send. */
+export function asksLeaveToSend(reply: string): boolean {
+  const questions = reply.match(/[^.!?？\n]*[?？]/gu) ?? [];
+  const last = questions[questions.length - 1] ?? '';
+  return ASKS_LEAVE_TO_SEND_RE.test(last);
+}
+
