From 8f1e415cdcf4e46ba4264dc895e5606084128a5f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 10:43:03 +0000
Subject: [PATCH] Revert "3106 (speed): the server finds the weather, and the
 first turn answers"

This reverts commit 0326b30d1a9caac725f5914bacadb88fe8773804.
---
 .../__tests__/smallTalkIsNeverAGoal.test.ts   |  6 +-
 .../theWeatherLooksForNobody.test.ts          | 24 +-----
 src/services/chat.service.ts                  | 82 ++-----------------
 3 files changed, 11 insertions(+), 101 deletions(-)

diff --git a/src/services/__tests__/smallTalkIsNeverAGoal.test.ts b/src/services/__tests__/smallTalkIsNeverAGoal.test.ts
index 67afdc4..3f56ca9 100644
--- a/src/services/__tests__/smallTalkIsNeverAGoal.test.ts
+++ b/src/services/__tests__/smallTalkIsNeverAGoal.test.ts
@@ -177,11 +177,9 @@ describe('a question about the weather', () => {
     expect(asksTheWeather(line)).toBe(false);
   });
 
-  // 3106 (speed): the server searches first; the forced search is the fallback when it cannot.
-  it('looks the weather up: the server first, the forced model search as the fallback', () => {
+  it('makes the first model call search the web when the run has web_search', () => {
     const chat = readFileSync(join(__dirname, '..', 'chat.service.ts'), 'utf8');
-    expect(chat).toContain('? { forceTool: WEB_SEARCH_TOOL }');
-    expect(chat).toContain('weatherFoundFirst(userId, threadId, runId');
+    expect(chat).toContain('...(weatherLookUp && { forceTool: WEB_SEARCH_TOOL }),');
     expect(chat).toContain("tool_choice: { type: 'tool' as const, name: opts.forceTool }");
   });
 });
diff --git a/src/services/__tests__/theWeatherLooksForNobody.test.ts b/src/services/__tests__/theWeatherLooksForNobody.test.ts
index 2ee5a8c..5cd0dbb 100644
--- a/src/services/__tests__/theWeatherLooksForNobody.test.ts
+++ b/src/services/__tests__/theWeatherLooksForNobody.test.ts
@@ -30,27 +30,7 @@ describe('a weather question looks for nobody (3106)', () => {
     expect(source).toContain('runLooksUpTheWeather.delete(runId);');
   });
 
-  /**
-   * The speed half (58029: 18.0 / 19.2 / 19.1 s against 12): the server searches
-   * first and the model answers in its first turn, from the opening-search
-   * section. If the server's search fails, the run searches itself as before.
-   */
-  it('searches before the first turn, and the first turn is the answer', () => {
-    expect(source).toContain(
-      "await weatherFoundFirst(userId, threadId, runId, lastOwnerText(messages) ?? '')",
-    );
-    expect(source).toContain("systemPrompt + shortTurnNote + (weatherFound ?? '')");
-    expect(source).toMatch(
-      /weatherFound === null\s+\? \{ forceTool: WEB_SEARCH_TOOL \}\s+: \{ forceText: true, maxTokens: DISCUSS_MAX_TOKENS \}/,
-    );
-  });
-
-  it('logs, costs and registers the server’s weather search like the model’s own', () => {
-    const fn = source.slice(source.indexOf('async function weatherFoundFirst('));
-    const body = fn.slice(0, fn.indexOf('\n}\n'));
-    expect(body).toContain("priceKey: 'tavily.search'");
-    expect(body).toContain("tool: 'web_search:weather'");
-    expect(body).toContain('registerWebResult(runId, raw);');
-    expect(body).toContain('buildOpeningSearchSection(');
+  it('still looks the weather up on the web', () => {
+    expect(source).toContain('...(weatherLookUp && { forceTool: WEB_SEARCH_TOOL })');
   });
 });
diff --git a/src/services/chat.service.ts b/src/services/chat.service.ts
index 0e56f48..d84e6b2 100644
--- a/src/services/chat.service.ts
+++ b/src/services/chat.service.ts
@@ -5622,61 +5622,6 @@ const runWebFound = new Set<string>();
  * in a weather question, so it searches the web and nothing else.
  */
 const runLooksUpTheWeather = new Set<string>();
-
-/**
- * 3106, the speed half (the tester's 58029, 14 Oct: 18.0 / 19.2 / 19.1 s against
- * 12). A weather run spent one whole model turn deciding to call the web search
- * it was forced to call (~6 s before the search began). The server now runs that
- * one search itself and hands the results over in the opening-search section, the
- * same text a goal's opening search uses, so the model answers in its first turn.
- * Null on any failure: the run then falls back to the forced search, as before.
- */
-async function weatherFoundFirst(
-  userId: string,
-  threadId: number,
-  runId: string,
-  ownerLine: string,
-): Promise<string | null> {
-  const startedAt = Date.now();
-  try {
-    const raw = await webSearch(ownerLine);
-    void recordFixedUsage({
-      userId,
-      kind: 'web_search',
-      provider: 'tavily',
-      priceKey: 'tavily.search',
-      runId,
-    }).catch(() => {});
-    void logToolCall({
-      threadId,
-      surface: 'chat',
-      runId,
-      userId,
-      tool: 'web_search:weather',
-      input: { query: ownerLine },
-      result: raw,
-      durationMs: Date.now() - startedAt,
-    });
-    if (!hasWebResults(raw)) return null;
-    registerWebResult(runId, raw);
-    runWebFound.add(runId);
-    const section = buildOpeningSearchSection({
-      web: JSON.stringify(raw),
-      secondDegree: null,
-      missing: [],
-      waysIn: new Map(),
-      webRaw: raw,
-    });
-    return section === '' ? null : section;
-  } catch (err) {
-    // eslint-disable-next-line no-console
-    console.warn(
-      '[weather] server search failed, the run searches itself:',
-      (err as Error).message,
-    );
-    return null;
-  }
-}
 /** #893: the labels of the list this run worked, for the check that the reply names every row. */
 const runListLabels = new Map<string, string[]>();
 /** The tool names this many rows to the model; a longer list is not checked row by row. */
@@ -13337,9 +13282,6 @@ async function runToolLoop(
     asksTheWeather(lastOwnerText(messages) ?? '') &&
     tools.some((tool) => tool.name === WEB_SEARCH_TOOL);
   if (weatherLookUp) runLooksUpTheWeather.add(runId);
-  const weatherFound = weatherLookUp
-    ? await weatherFoundFirst(userId, threadId, runId, lastOwnerText(messages) ?? '')
-    : null;
   let options: DisambiguationCandidate[] | undefined;
   let choices: string[] | undefined;
   // 2971: every step bubble the owner saw, so a question said only there is not lost.
@@ -13386,23 +13328,13 @@ async function runToolLoop(
   // meanwhile, so the two never mix on the screen.
   const earlyFinal = smallTalkOnly && writer !== '' ? writeWith(writer) : null;
   const firstTurnText = earlyFinal === null ? stream : undefined;
-  let response = await callClaude(
-    messages,
-    systemPrompt + shortTurnNote + (weatherFound ?? ''),
-    tools,
-    ctx,
-    {
-      onText: firstTurnText,
-      model: smallTalkOnly || tapSettledByServer ? SMALL_TALK_MODEL : TOOL_TURN_MODEL,
-      ...((otherTap || smallTalkOnly) && { forceText: true, maxTokens: GREETING_MAX_TOKENS }),
-      ...(discussing && { forceText: true, maxTokens: DISCUSS_MAX_TOKENS }),
-      // 3106: with the weather already found, the first turn is the answer.
-      ...(weatherLookUp &&
-        (weatherFound === null
-          ? { forceTool: WEB_SEARCH_TOOL }
-          : { forceText: true, maxTokens: DISCUSS_MAX_TOKENS })),
-    },
-  );
+  let response = await callClaude(messages, systemPrompt + shortTurnNote, tools, ctx, {
+    onText: firstTurnText,
+    model: smallTalkOnly || tapSettledByServer ? SMALL_TALK_MODEL : TOOL_TURN_MODEL,
+    ...((otherTap || smallTalkOnly) && { forceText: true, maxTokens: GREETING_MAX_TOKENS }),
+    ...(discussing && { forceText: true, maxTokens: DISCUSS_MAX_TOKENS }),
+    ...(weatherLookUp && { forceTool: WEB_SEARCH_TOOL }),
+  });
   // The tester's 997 (29833, run 44e53e23): the first answer came back with no
   // text and no tool call, and the owner was told „try again" — the same words
   // sent again a minute later worked. A blank first answer is asked once more
-- 
2.43.0

