 .../theDebitWaitsForTheAnswer.test.ts         |  4 +++-
 src/services/chat.service.ts                  | 19 ++++++++++++++++++-
 5 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/src/api/routes/__tests__/planApprovalStatus.test.ts b/src/api/routes/__tests__/planApprovalStatus.test.ts
index 3244f6c..c0d0638 100644
--- a/src/api/routes/__tests__/planApprovalStatus.test.ts
+++ b/src/api/routes/__tests__/planApprovalStatus.test.ts
@@ -222,3 +222,20 @@ describe('a plan proposed and not yet approved is waiting on the OWNER', () => {
     ).toBe('needs_you');
   });
 });
+
+/** 0312's status fault (tester box 58942): the server said nothing went, so the owner is next. */
+describe('a goal where the server said nothing went', () => {
+  const nothingWent = {
+    reply: 'ნინო ლომიძე Netai-ზე ჯერ არ არის, ამიტომ კითხვა ვერ გავუგზავნე.',
+    ownerDecidesNext: true,
+  } as Parameters<typeof statusAfterRun>[0];
+  const openGoal = { workItem: true, flagged: false, awaitingPlanApproval: false, openGoal: true };
+
+  it('needs the owner, not „waiting"', () => {
+    expect(statusAfterRun(nothingWent, false, openGoal)).toBe('needs_you');
+  });
+
+  it('still waits while somebody else has a question out', () => {
+    expect(statusAfterRun(nothingWent, true, openGoal)).toBe('waiting');
+  });
+});
diff --git a/src/api/routes/threads.routes.ts b/src/api/routes/threads.routes.ts
index 27020f7..38ba57d 100644
--- a/src/api/routes/threads.routes.ts
+++ b/src/api/routes/threads.routes.ts
@@ -243,6 +243,8 @@ export function statusAfterRun(
   // nothing, however chatty the acknowledgement was (ticket 6 B2: thread 8556
   // stayed needs_you because its reply ended with a question).
   if (pendingAsk) return 'waiting';
+  // 0312's status fault (58942): the server said nothing went to anyone, so nobody else is awaited.
+  if (result.ownerDecidesNext === true) return 'needs_you';
   // Ticket 8 task 2(b): the badge means "this thread waits for the user",
   // nothing else — and only a WORK item can wait for the user. A plain
   // conversation whose last reply happens to end with a question is finished
