@@ -16103,6 +16103,14 @@ export async function processChat(
 
   const listedSmallTalk = !ownerAbsent && isToolFreeSmallTalk(userMessage);
   steps.mark('named');
+  // 3106 (speed): the two reads the run's language needs depend on nothing the
