+    const res = await fetch(`${base}/latest`);
+    expect(res.status).toBe(500);
+    const body = (await res.json()) as { success: boolean; error: string };
+    expect(body.success).toBe(false);
+    expect(body.error).not.toContain('connection');
+  });
+});
