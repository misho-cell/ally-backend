diff --git a/src/services/__tests__/everyButtonSetHasAnOther.test.ts b/src/services/__tests__/everyButtonSetHasAnOther.test.ts
index 7dc2566..463c10b 100644
--- a/src/services/__tests__/everyButtonSetHasAnOther.test.ts
+++ b/src/services/__tests__/everyButtonSetHasAnOther.test.ts
@@ -15,13 +15,19 @@ import {
  */
 describe('withOtherChoice', () => {
   it('adds the other option after the model’s own buttons', () => {
-    expect(withOtherChoice(['ვამტკიცებ', 'შევცვალოთ'], 'ka')).toEqual([
+    expect(withOtherChoice(['ვამტკიცებ', 'ვიფიქრებ'], 'ka')).toEqual([
       'ვამტკიცებ',
-      'შევცვალოთ',
+      'ვიფიქრებ',
       'სხვა, მე დავწერ',
     ]);
   });
 
+  /** #5126 (Giorgi, 15 Oct): „change it" already lets the owner type. */
+  it('adds none beside the plan card’s own „change it", in any language', () => {
+    expect(withOtherChoice(['ვადასტურებ', 'შევცვალოთ'], 'ka')).toEqual(['ვადასტურებ', 'შევცვალოთ']);
+    expect(withOtherChoice(['I approve', 'Change it'], 'en')).toEqual(['I approve', 'Change it']);
+  });
+
   it('speaks the conversation’s language', () => {
     expect(withOtherChoice(['Yes', 'No'], 'en')).toEqual(['Yes', 'No', "Other, I'll write it"]);
     expect(otherChoiceLabel('ru')).toBe('Другое, напишу сам');
diff --git a/src/services/otherChoice.ts b/src/services/otherChoice.ts
index 2c06a53..15fbb83 100644
--- a/src/services/otherChoice.ts
+++ b/src/services/otherChoice.ts
@@ -1,3 +1,4 @@
+import { CHANGE_LABEL } from './choiceNotes';
 import type { RunLanguage } from './runLanguage';
 
 /**
@@ -30,13 +31,26 @@ export function otherChoiceLabel(language: RunLanguage): string {
   return OTHER_LABELS[language];
 }
 
+/** The plan card's „change it" in every language: it already opens the owner's own words. */
+const CHANGE_LABELS: ReadonlySet<string> = new Set(Object.values(CHANGE_LABEL));
+
+/**
+ * #5126 (Giorgi, 15 Oct): the plan card offered „ვადასტურებ", „შევცვალოთ" and
+ * „სხვა, მე დავწერ" — and the last two are the same act, since „change it"
+ * lets the owner type. A set that carries the server's own „change it" gets no
+ * „other".
+ */
+function offersItsOwnWords(choices: readonly string[]): boolean {
+  return choices.some((choice) => isAnOtherOption(choice) || CHANGE_LABELS.has(choice.trim()));
+}
+
 /** The buttons with „other, I'll write it" after them; none stays none. */
 export function withOtherChoice(
   choices: readonly string[] | null,
   language: RunLanguage,
 ): string[] | null {
   if (choices === null || choices.length === 0) return choices === null ? null : [];
-  if (choices.some(isAnOtherOption)) return [...choices];
+  if (offersItsOwnWords(choices)) return [...choices];
   return [...choices, otherChoiceLabel(language)];
 }
 
