From fad5a612adbf51b16b9465d2b26d84337b66b64c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 12:16:10 +0000
Subject: [PATCH] 1688: the ask thread's title drops the name in front when the
 question names the asker anywhere
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The tester's re-run of 0332 (box 60030): „<asker>: ხვალ საღამოს თავისუფალი ხარ
<asker>-ის ყ…" — the name was mid-question, and 0332 only looked at its start.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 .../__tests__/anAskCarriesTheOtherButton.test.ts       |  6 ++++++
 src/services/taskAsks.service.ts                       | 10 +++++-----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/services/__tests__/anAskCarriesTheOtherButton.test.ts b/src/services/__tests__/anAskCarriesTheOtherButton.test.ts
index af66dce..335a5c5 100644
--- a/src/services/__tests__/anAskCarriesTheOtherButton.test.ts
+++ b/src/services/__tests__/anAskCarriesTheOtherButton.test.ts
@@ -50,6 +50,12 @@ describe('the title of an incoming question’s thread', () => {
     );
   });
 
+  it('does not say it twice when the question names the asker mid-sentence', () => {
+    expect(
+      askThreadTitle('Netai Test 7', 'ხვალ საღამოს თავისუფალი ხარ Netai Test 7-ის ყავაზე?'),
+    ).toBe('ხვალ საღამოს თავისუფალი ხარ Netai Test 7-ის ყავაზე?');
+  });
+
   it('puts the name in front when the question does not open with it', () => {
     expect(askThreadTitle('Lika Ose', 'კარგ ფოტოგრაფს იცნობ?')).toBe(
       'Lika Ose: კარგ ფოტოგრაფს იცნობ?',
diff --git a/src/services/taskAsks.service.ts b/src/services/taskAsks.service.ts
index b11999a..98f59b0 100644
--- a/src/services/taskAsks.service.ts
+++ b/src/services/taskAsks.service.ts
@@ -172,14 +172,14 @@ function titleSnippetFrom(question: string): string {
 }
 /**
  * 1688 (Lika's phone, 15 Oct): the header read „Lika Ose: Lika Ose-ს კარგი
- * ფოტოგრაფი…" — the question already opens with the asker's name, so the name
- * in front said it twice. It goes in front only when the question does not.
+ * ფოტოგრაფი…" — the question already names the asker, so the name in front
+ * said it twice. The tester's re-run (box 60030) had it mid-question: „<asker>:
+ * ხვალ საღამოს თავისუფალი ხარ <asker>-ის ყ…". The name goes in front only when
+ * the question does not name the asker anywhere.
  */
 export function askThreadTitle(senderName: string, snippet: string): string {
   const name = senderName.trim();
-  if (name === '' || snippet.trimStart().toLowerCase().startsWith(name.toLowerCase())) {
-    return snippet;
-  }
+  if (name === '' || snippet.toLowerCase().includes(name.toLowerCase())) return snippet;
   return `${name}: ${snippet}`;
 }
 // Anti-runaway ceiling, not a product limit (the product decision is "no
