diff --git a/src/api/middleware/__tests__/rateLimit.middleware.test.ts b/src/api/middleware/__tests__/rateLimit.middleware.test.ts
index fd014a4..9cd81f3 100644
--- a/src/api/middleware/__tests__/rateLimit.middleware.test.ts
+++ b/src/api/middleware/__tests__/rateLimit.middleware.test.ts
@@ -101,3 +101,37 @@ describe('rateLimit: each limiter has its own budget (4927, 4928)', () => {
     expect(hit(shared, user, 2)).toBe(1);
   });
 });
+
+/** The 21 Oct launch (60292; Misho, 15 Oct): a room on one Wi-Fi signs up together. */
+describe('rateLimit keyBy: person', () => {
+  const PERSON: RateLimitOptions = { windowMs: 60_000, max: 2, keyBy: 'person' };
+  const withPhone = (phone: string, headers: Record<string, string> = {}): Request =>
+    ({ headers, ip: '10.0.0.9', body: { phone } }) as unknown as Request;
+
+  it('counts each phone on one address on its own', () => {
+    const mw = rateLimit(PERSON);
+    expect(hit(mw, withPhone('+995 555 00 00 01'), 3)).toBe(2);
+    expect(hit(mw, withPhone('+995 555 00 00 02'), 2)).toBe(2);
+  });
+
+  it('reads one phone however it is spaced', () => {
+    const mw = rateLimit(PERSON);
+    expect(hit(mw, withPhone('+995 555 00 00 03'), 2)).toBe(2);
+    expect(hit(mw, withPhone('995555000003'), 1)).toBe(0);
+  });
+
+  it('prefers the device id, then falls back to the address with neither', () => {
+    const mw = rateLimit(PERSON);
+    expect(hit(mw, withPhone('+995 555 00 00 04', { 'x-device-id': 'dev-P' }), 2)).toBe(2);
+    expect(hit(mw, withPhone('+995 555 00 00 05', { 'x-device-id': 'dev-P' }), 1)).toBe(0);
+    expect(hit(mw, makeReq({}, '10.0.0.7'), 3)).toBe(2);
+  });
+});
+
+describe('rateLimit keyBy: ip', () => {
+  it('counts the address even for a signed-in user', () => {
+    const mw = rateLimit({ windowMs: 60_000, max: 2, keyBy: 'ip' });
+    const req = { headers: {}, ip: '10.0.0.8', user: { userId: '7' } } as unknown as Request;
+    expect(hit(mw, req, 3)).toBe(2);
+  });
+});
diff --git a/src/api/middleware/rateLimit.middleware.ts b/src/api/middleware/rateLimit.middleware.ts
index 9802d3b..656e1cb 100644
--- a/src/api/middleware/rateLimit.middleware.ts
+++ b/src/api/middleware/rateLimit.middleware.ts
@@ -39,8 +39,34 @@ function deviceKey(req: Request): string {
   return `ip:${clientIp(req)}`;
 }
 
+// The phone number a sign-in step is about, digits only, from the parsed body.
+function phoneInBody(req: Request): string | null {
+  const body: unknown = req.body;
+  if (typeof body !== 'object' || body === null) return null;
+  const phone = (body as Record<string, unknown>).phone;
+  if (typeof phone !== 'string') return null;
+  const digits = phone.replace(/\D/g, '');
+  return digits === '' ? null : digits;
+}
+
+/**
+ * The launch of 21 Oct (the tester's 60292; Misho, 15 Oct): a hundred people
+ * signing up in one room share one Wi-Fi address, and an IP-keyed limit let
+ * about ten of them through. A sign-in step is counted for the PERSON: the
+ * app's device id when it sends one, else the phone number the step is about,
+ * else, with neither, the address.
+ */
+function personKey(req: Request): string {
+  const id = req.headers['x-device-id'];
+  if (typeof id === 'string' && id.trim().length > 0) return `dev:${id.trim()}`;
+  const phone = phoneInBody(req);
+  return phone === null ? `ip:${clientIp(req)}` : `ph:${phone}`;
+}
+
 function keyFor(req: Request, keyBy: RateLimitOptions['keyBy']): string {
   if (keyBy === 'device') return deviceKey(req);
+  if (keyBy === 'person') return personKey(req);
+  if (keyBy === 'ip') return `ip:${clientIp(req)}`;
   const user = (req as AuthenticatedRequest).user;
   if (user?.userId) return `u:${user.userId}`;
   return `ip:${clientIp(req)}`;
@@ -50,8 +76,9 @@ export interface RateLimitOptions {
   windowMs: number;
   max: number;
   // 'device' keys by X-Device-Id (then IP) — for unauthenticated abuse control.
-  // Default 'auto' keys by user when authenticated, else IP.
-  keyBy?: 'auto' | 'device';
+  // 'person' keys by X-Device-Id, then the body's phone, then IP — sign-in steps.
+  // 'ip' keys by the address alone. Default 'auto': by user when authenticated, else IP.
+  keyBy?: 'auto' | 'device' | 'person' | 'ip';
   // Fired (best-effort, after the 429 is sent) so a route can leave a visible
   // trace — a rejected chat send used to leave the thread silently empty
   // forever (ticket 6 protocol run, task 38 / thread 9873).
diff --git a/src/api/routes/__tests__/aRoomCanSignUpTogether.test.ts b/src/api/routes/__tests__/aRoomCanSignUpTogether.test.ts
new file mode 100644
index 0000000..9303e59
--- /dev/null
+++ b/src/api/routes/__tests__/aRoomCanSignUpTogether.test.ts
@@ -0,0 +1,26 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+/**
+ * The 21 Oct launch (the tester's 60292; Misho, 15 Oct): a hundred people on
+ * one room's Wi-Fi. The sign-in routes were capped at 30 per five minutes per
+ * ADDRESS, which let about ten of them in.
+ */
+describe('the sign-in limits', () => {
+  const routes = readFileSync(join(__dirname, '..', 'auth.routes.ts'), 'utf8');
+
+  it('count the person at the old cap, and the address at ten times it', () => {
+    expect(routes).toContain('const AUTH_MAX_PER_PERSON = 30;');
+    expect(routes).toContain('const AUTH_MAX_PER_ADDRESS = 300;');
+    expect(routes).toContain("max: AUTH_MAX_PER_ADDRESS, keyBy: 'ip'");
+    expect(routes).toContain("max: AUTH_MAX_PER_PERSON, keyBy: 'person'");
+    expect(routes).not.toContain('authRouter.use(rateLimit({ windowMs: 5 * 60_000, max: 30 }));');
+  });
+
+  it('keep the SMS sends at five per person, not per address', () => {
+    expect(routes).toContain('max: OTP_SEND_MAX_PER_PERSON,');
+    expect(routes).toContain('const OTP_SEND_MAX_PER_PERSON = 5;');
+    const sends = routes.slice(routes.indexOf('const limitOtpSends'));
+    expect(sends.slice(0, sends.indexOf('});'))).toContain("keyBy: 'person'");
+  });
+});
diff --git a/src/api/routes/auth.routes.ts b/src/api/routes/auth.routes.ts
index 5931189..df91b01 100644
--- a/src/api/routes/auth.routes.ts
+++ b/src/api/routes/auth.routes.ts
@@ -78,17 +78,30 @@ export function referralCodeFrom(body: unknown): ReferralCodeIn {
   return {};
 }
 
-// Unauthenticated endpoints — limit by IP to curb OTP/login abuse.
-authRouter.use(rateLimit({ windowMs: 5 * 60_000, max: 30 }));
+/**
+ * Unauthenticated endpoints, counted twice (Misho, 15 Oct, for the 21 Oct
+ * launch: a hundred people signing up on one room's Wi-Fi).
+ *
+ * Per PERSON — the device, else the phone the step is about — the old cap of
+ * 30 in five minutes, which is the abuse control. Per ADDRESS a cap ten times
+ * that, so a shared Wi-Fi lets a room in while one address still cannot
+ * hammer the login without end.
+ */
+const AUTH_WINDOW_MS = 5 * 60_000;
+const AUTH_MAX_PER_PERSON = 30;
+const AUTH_MAX_PER_ADDRESS = 300;
+authRouter.use(rateLimit({ windowMs: AUTH_WINDOW_MS, max: AUTH_MAX_PER_ADDRESS, keyBy: 'ip' }));
+authRouter.use(rateLimit({ windowMs: AUTH_WINDOW_MS, max: AUTH_MAX_PER_PERSON, keyBy: 'person' }));
 
-// Tighter, per-device limit on the SMS-sending endpoints specifically, so a
-// single device can't burn the SMS budget behind a shared/NAT'd IP (F4).
+// Tighter limit on the SMS-sending endpoints specifically, so one device —
+// or, from an app that sends no device id, one phone — can't burn the SMS
+// budget (F4). Keyed by the person, not the address, for the same room.
 const OTP_SEND_WINDOW_MS = 10 * 60_000;
-const OTP_SEND_MAX_PER_DEVICE = 5;
+const OTP_SEND_MAX_PER_PERSON = 5;
 const limitOtpSends = rateLimit({
   windowMs: OTP_SEND_WINDOW_MS,
-  max: OTP_SEND_MAX_PER_DEVICE,
-  keyBy: 'device',
+  max: OTP_SEND_MAX_PER_PERSON,
+  keyBy: 'person',
 });
 
 authRouter.post(
