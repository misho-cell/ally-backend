+/** The pause before the one retry of a failed error-line write. */
+const ERROR_LINE_RETRY_MS = 2_000;
+
+/**
+ * F5: whether this run's real answer is already in the thread; when it is, the
+ * run is ended on the screen with that answer and the thread is given the
+ * status the work is in. A failed read counts as no answer.
+ */
+async function answerAlreadyStored(
+  userId: string,
+  threadId: number,
+  runId: string,
+): Promise<boolean> {
+  try {
+    const stored = await query<{ content: string }>(
+      `SELECT content FROM conversations
+        WHERE thread_id = $1 AND run_id = $2 AND role = 'assistant' AND kind = 'message'
+          AND content <> ''
+        ORDER BY created_at DESC
+        LIMIT 1`,
+      [threadId, runId],
+    );
+    const answer = stored.rows[0]?.content;
+    if (answer === undefined) return false;
+    // eslint-disable-next-line no-console
+    console.warn(
+      `[run] ${runId} thread ${threadId}: failed after its answer was stored — no error line`,
+    );
+    emitRunComplete(userId, threadId, runId, { reply: answer });
+    const openGoal = await getOpenTaskByThread(threadId).catch(() => null);
+    void setThreadStatus(userId, threadId, openGoal === null ? 'done' : 'waiting');
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** F5: the error line a failed run owes the owner, tried a second time if the first write fails. */
+function saveErrorLineOnce(threadId: number, userId: string, line: string, runId: string): void {
+  const write = (): Promise<unknown> =>
+    saveThreadMessage(threadId, Number(userId), 'assistant', line, 'error', runId);
+  write().catch(() => {
+    setTimeout(() => {
+      write().catch((err: unknown) => {
+        // eslint-disable-next-line no-console
+        console.error(
+          `[run] ${runId}: the error line could not be stored:`,
+          (err as Error).message,
+        );
+      });
+    }, ERROR_LINE_RETRY_MS);
+  });
+}
