diff --git a/src/services/__tests__/theConnectorDoorAsksTheInvitation.test.ts b/src/services/__tests__/theConnectorDoorAsksTheInvitation.test.ts
new file mode 100644
index 0000000..0234b5d
--- /dev/null
+++ b/src/services/__tests__/theConnectorDoorAsksTheInvitation.test.ts
@@ -0,0 +1,40 @@
+const mockQuery = jest.fn();
+jest.mock('../../db/postgres/client', () => ({ query: (...a: unknown[]) => mockQuery(...a) }));
+const mockVerdict = jest.fn();
+jest.mock('../auth.service', () => ({ loginGateVerdict: (...a: unknown[]) => mockVerdict(...a) }));
+
+import { admittedUserIdByPhone } from '../connectorAdmission.service';
+
+const PHONE = '+995500000001';
+
+/** 5419: the connector's sign-in asks the same invitation gate as the app's. */
+describe('the connector door asks the invitation', () => {
+  beforeEach(() => jest.resetAllMocks());
+
+  it('admits an account the app sign-in admits', async () => {
+    mockQuery.mockResolvedValue({ rows: [{ userId: 42 }] });
+    mockVerdict.mockResolvedValue({ would_be_admitted: true });
+    await expect(admittedUserIdByPhone(PHONE)).resolves.toBe('42');
+    expect(mockVerdict).toHaveBeenCalledWith(42);
+  });
+
+  it('refuses a legacy account nobody invited while the gate is on', async () => {
+    mockQuery.mockResolvedValue({ rows: [{ userId: 42 }] });
+    mockVerdict.mockResolvedValue({ would_be_admitted: false });
+    await expect(admittedUserIdByPhone(PHONE)).resolves.toBeNull();
+  });
+
+  it('refuses a number that is no account, without asking the gate', async () => {
+    mockQuery.mockResolvedValue({ rows: [] });
+    await expect(admittedUserIdByPhone(PHONE)).resolves.toBeNull();
+    expect(mockVerdict).not.toHaveBeenCalled();
+  });
+
+  it('looks the number up with and without its plus, under a timeout', async () => {
+    mockQuery.mockResolvedValue({ rows: [] });
+    await admittedUserIdByPhone(PHONE);
+    const [, params, timeout] = mockQuery.mock.calls[0] as [string, unknown[], number];
+    expect(params).toEqual([[PHONE, PHONE.slice(1)]]);
+    expect(timeout).toBeGreaterThan(0);
+  });
+});
diff --git a/src/services/connectorAdmission.service.ts b/src/services/connectorAdmission.service.ts
new file mode 100644
index 0000000..ee6d405
--- /dev/null
+++ b/src/services/connectorAdmission.service.ts
@@ -0,0 +1,32 @@
+import { query } from '../db/postgres/client';
+import { loginGateVerdict } from './auth.service';
+
+const PHONE_LOOKUP_TIMEOUT_MS = 5_000;
+
+async function findUserIdByPhone(phone: string): Promise<number | null> {
+  const variants = [phone, phone.startsWith('+') ? phone.slice(1) : `+${phone}`];
+  const result = await query<{ userId: number }>(
+    'SELECT "userId" FROM "UserPhone" WHERE phone = ANY($1) LIMIT 1',
+    [variants],
+    PHONE_LOOKUP_TIMEOUT_MS,
+  );
+  return result.rows[0]?.userId ?? null;
+}
+
+/**
+ * 5419 (founder's word, 16 Oct: strictly invite only, through every door). The
+ * connector's sign-in (ChatGPT / Claude, /oauth/authorize) admitted any number
+ * in "UserPhone" — the 62,000 legacy Ally accounts among them — with no
+ * invitation, around the login gate the app's own sign-in asks
+ * (`completeLogin`). And a thread made through the connector then makes the
+ * account "belong to Netai", so the app's gate opened for it too.
+ *
+ * The connector now asks the same gate, through the same verdict: the account
+ * whose number this is, only when the app's sign-in would admit it; else null.
+ */
+export async function admittedUserIdByPhone(phone: string): Promise<string | null> {
+  const userId = await findUserIdByPhone(phone);
+  if (userId === null) return null;
+  const verdict = await loginGateVerdict(userId);
+  return verdict.would_be_admitted ? String(userId) : null;
+}
