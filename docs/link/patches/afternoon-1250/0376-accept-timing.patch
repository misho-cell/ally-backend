diff --git a/src/services/__tests__/theAcceptTimesItself.test.ts b/src/services/__tests__/theAcceptTimesItself.test.ts
new file mode 100644
index 0000000..383c0e2
--- /dev/null
+++ b/src/services/__tests__/theAcceptTimesItself.test.ts
@@ -0,0 +1,29 @@
+import { PhaseClock, stampArrival } from '../acceptTiming';
+import type { NextFunction, Request, Response } from 'express';
+
+/** Run 8 (box 62242): the accept says where its time went, phase by phase. */
+describe('the accept times itself', () => {
+  it('stamps when the process first saw the request', () => {
+    const res = { locals: {} } as unknown as Response;
+    const next = jest.fn() as NextFunction;
+    stampArrival({} as Request, res, next);
+    expect(typeof res.locals.arrivedAt).toBe('number');
+    expect(next).toHaveBeenCalled();
+  });
+
+  it('reads each phase as the time since the one before, and the total from arrival', () => {
+    const clock = new PhaseClock(100);
+    clock.mark('thread', 150);
+    clock.mark('payer', 400);
+    // before_handler is measured from 100 to the real clock, so only the named phases are exact.
+    const line = clock.line(1_100);
+    expect(line).toContain('thread ');
+    expect(line).toContain('payer 250ms');
+    expect(line).toMatch(/total 1000ms$/);
+  });
+
+  it('starts from now when nothing stamped the arrival', () => {
+    const clock = new PhaseClock(undefined);
+    expect(clock.line()).toMatch(/^before_handler 0ms, total \d+ms$/);
+  });
+});
diff --git a/src/services/acceptTiming.ts b/src/services/acceptTiming.ts
new file mode 100644
index 0000000..5445f5d
--- /dev/null
+++ b/src/services/acceptTiming.ts
@@ -0,0 +1,43 @@
+import { performance } from 'perf_hooks';
+import type { NextFunction, Request, Response } from 'express';
+
+/**
+ * Run 8 (16 Oct, 200 hellos and nothing else, box 62242): accepting a message
+ * took 5.6 s for 100 at once against 1.4 s alone, and the answer — the server's
+ * own greeting, no model — 2.5–3.8 s against 0.5. The logs cannot say where: the
+ * host stamps them in batches (all 200 arrivals carry the same millisecond). So
+ * the accept measures itself, phase by phase, from the moment the request
+ * reached this process.
+ */
+const ARRIVED_AT = 'arrivedAt';
+
+/** First middleware: when this process first saw the request. */
+export function stampArrival(_req: Request, res: Response, next: NextFunction): void {
+  res.locals[ARRIVED_AT] = performance.now();
+  next();
+}
+
+/** The phases of one accept, each the time since the previous mark. */
+export class PhaseClock {
+  private readonly marks: [string, number][] = [];
+  private last: number;
+  private readonly start: number;
+
+  constructor(arrivedAt: unknown) {
+    const now = performance.now();
+    this.start = typeof arrivedAt === 'number' ? arrivedAt : now;
+    this.last = this.start;
+    this.mark('before_handler', now);
+  }
+
+  mark(phase: string, at: number = performance.now()): void {
+    this.marks.push([phase, Math.round(at - this.last)]);
+    this.last = at;
+  }
+
+  /** „before_handler 12ms, thread 40ms, …, total 900ms" */
+  line(at: number = performance.now()): string {
+    const parts = this.marks.map(([phase, ms]) => `${phase} ${ms}ms`);
+    return `${parts.join(', ')}, total ${Math.round(at - this.start)}ms`;
+  }
+}
