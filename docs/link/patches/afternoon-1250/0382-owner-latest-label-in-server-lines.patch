 src/services/__tests__/ownLabelIsTheName.test.ts       |  6 ++++--
 src/services/bridgePicker.ts                           |  4 ++--
 src/services/dailyContactQuestion.ts                   |  2 +-
 src/services/mediatorTargetName.ts                     |  2 +-
 src/services/newMemberForGoal.service.ts               |  2 +-
 src/services/savedNameSql.ts                           | 10 +++++++---
 .../theUsableRouteMustReachTheRanking.test.ts          |  6 +++---
 src/services/tools/searchSecondDegree.ts               |  2 +-
 8 files changed, 20 insertions(+), 14 deletions(-)

diff --git a/src/services/__tests__/ownLabelIsTheName.test.ts b/src/services/__tests__/ownLabelIsTheName.test.ts
index 892f72a..2dfbfbc 100644
--- a/src/services/__tests__/ownLabelIsTheName.test.ts
+++ b/src/services/__tests__/ownLabelIsTheName.test.ts
@@ -33,8 +33,10 @@ describe('the name a viewer sees for a member', () => {
     expect(sql.lastIndexOf('"UserAlias"')).toBeGreaterThan(sql.indexOf('"User" sv_u'));
   });
 
-  it('picks the same spelling every time', () => {
-    expect(sql).toContain('ORDER BY LENGTH(TRIM(sv_ua.alias)) DESC, sv_ua.alias');
+  // 62340: the label saved last wins, not the longest (Helper C over Levani).
+  it('picks the label the viewer saved last', () => {
+    expect(sql).toContain('ORDER BY sv_ua.id DESC');
+    expect(sql).not.toContain('LENGTH(TRIM(sv_ua.alias)) DESC');
   });
 
   it('looks from the asker at the asked, and from the reader at the asker', () => {
diff --git a/src/services/bridgePicker.ts b/src/services/bridgePicker.ts
index 48422c4..e4940dc 100644
--- a/src/services/bridgePicker.ts
+++ b/src/services/bridgePicker.ts
@@ -249,7 +249,7 @@ function detailsByName(
   return details;
 }
 
-/** The bridge's own name for one phone: registered name, else their fullest label. */
+/** The bridge's own name for one phone: registered name, else the label they saved last. */
 export async function nameInBridgeBook(
   bridgeUserId: string,
   phone: string,
@@ -265,7 +265,7 @@ export async function nameInBridgeBook(
         -- compared as digits, so the bridge's own name is found either way.
         AND regexp_replace(ua.phone, '\\D', '', 'g') = regexp_replace($2, '\\D', '', 'g')
         AND NULLIF(TRIM(ua.alias), '') IS NOT NULL
-      ORDER BY LENGTH(TRIM(ua.alias)) DESC, ua.alias
+      ORDER BY ua.id DESC
       LIMIT 1`,
     [bridgeUserId, phone],
     PICKED_NAME_TIMEOUT_MS,
diff --git a/src/services/dailyContactQuestion.ts b/src/services/dailyContactQuestion.ts
