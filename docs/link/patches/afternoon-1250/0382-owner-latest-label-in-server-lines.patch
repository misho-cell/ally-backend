--- a/src/services/dailyContactQuestion.ts
+++ b/src/services/dailyContactQuestion.ts
@@ -167,7 +167,7 @@ async function questionAwaitingAnswer(userId: string): Promise<PendingQuestion |
                WHERE ua."contactId" = l.user_id
