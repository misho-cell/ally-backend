          SELECT ua.alias
            FROM "UserAlias" ua
           WHERE ua."contactId"::text = tg.user_id AND ua.phone = $1
-          ORDER BY LENGTH(TRIM(ua.alias)) DESC
+          ORDER BY ua.id DESC
           LIMIT 1
        ) own_label ON TRUE
       -- ⚠️ NOT THE OWNER ABOUT THEMSELVES, and this guard only started doing
diff --git a/src/services/savedNameSql.ts b/src/services/savedNameSql.ts
index 691ba32..174034d 100644
--- a/src/services/savedNameSql.ts
+++ b/src/services/savedNameSql.ts
@@ -5,8 +5,12 @@
  * another owner's label is never shown to her.
  *
  * The name the VIEWER sees for MEMBER: the viewer's own label for any of the
- * member's numbers (the fullest clean spelling, ties broken alphabetically so
- * it never changes between two replies), else the member's registered name.
+ * member's numbers (the one she saved last, so a rename shows at once and the
+ * same name comes back every reply), else the member's registered name.
+ *
+ * The tester's 62340 (55012, 55015): a seat saved as „Helper C …" and later as
+ * „Levani …" was still told as Helper C, because the longer label won. The
+ * latest label wins here as it does in search (0381).
  * Both arguments are SQL expressions for integer user ids — column
  * references, never text from a request.
  *
@@ -30,7 +34,7 @@ function labelOf(viewerIdSql: string, memberIdSql: string, cleanOnly: boolean):
         AND sv_up."userId" = ${memberIdSql}
         AND NULLIF(TRIM(sv_ua.alias), '') IS NOT NULL
         ${clean}
-      ORDER BY LENGTH(TRIM(sv_ua.alias)) DESC, sv_ua.alias
+      ORDER BY sv_ua.id DESC
       LIMIT 1)`;
 }
 
diff --git a/src/services/tools/__tests__/theUsableRouteMustReachTheRanking.test.ts b/src/services/tools/__tests__/theUsableRouteMustReachTheRanking.test.ts
index 6b8647a..df3a154 100644
--- a/src/services/tools/__tests__/theUsableRouteMustReachTheRanking.test.ts
+++ b/src/services/tools/__tests__/theUsableRouteMustReachTheRanking.test.ts
@@ -238,13 +238,13 @@ describe('one bridge is named once', () => {
 
   /**
    * Deterministic, because a search run twice that names the bridge two
-   * different ways is its own bug. Longest spelling wins — the fullest form of
-   * the name is the one worth showing — and the alias itself breaks a tie.
+   * different ways is its own bug. The label the owner saved last wins (62340),
+   * the same rule as every other line she reads.
    */
   it('chooses the same spelling every time', () => {
     const lateral = sql.slice(sql.indexOf('LEFT JOIN LATERAL ('), sql.indexOf(') ua_via ON TRUE'));
 
-    expect(lateral).toContain('ORDER BY LENGTH(TRIM(ua.alias)) DESC, ua.alias');
+    expect(lateral).toContain('ORDER BY ua.id DESC');
     expect(lateral).toContain('LIMIT 1');
   });
 
diff --git a/src/services/tools/searchSecondDegree.ts b/src/services/tools/searchSecondDegree.ts
index 972b032..7abefcc 100644
--- a/src/services/tools/searchSecondDegree.ts
+++ b/src/services/tools/searchSecondDegree.ts
@@ -1280,7 +1280,7 @@ export async function searchSecondDegree(userId: string, tagQuery: string): Prom
           WHERE ua.phone = fu.via_phone
             AND ua."contactId" = $1
             AND NULLIF(TRIM(ua.alias), '') IS NOT NULL
-          ORDER BY LENGTH(TRIM(ua.alias)) DESC, ua.alias
+          ORDER BY ua.id DESC
           LIMIT 1
        ) ua_via ON TRUE
        LEFT JOIN "User"      u_via  ON u_via.id     = fu."userId"
