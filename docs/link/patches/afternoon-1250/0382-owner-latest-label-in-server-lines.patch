diff --git a/src/services/newMemberForGoal.service.ts b/src/services/newMemberForGoal.service.ts
index 8292082..e3e00ec 100644
--- a/src/services/newMemberForGoal.service.ts
+++ b/src/services/newMemberForGoal.service.ts
