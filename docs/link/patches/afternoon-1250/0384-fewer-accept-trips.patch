diff --git a/src/services/__tests__/theTitleIsWrittenBesideTheWallet.test.ts b/src/services/__tests__/theTitleIsWrittenBesideTheWallet.test.ts
new file mode 100644
index 0000000..ba29cf2
--- /dev/null
+++ b/src/services/__tests__/theTitleIsWrittenBesideTheWallet.test.ts
@@ -0,0 +1,28 @@
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+/**
+ * Run 9 (16 Oct, 200 „გამარჯობა" at once): outside the load every accept phase
+ * was a multiple of ~150 ms, one round trip each, and the provisional title
+ * waited for the thread while the wallet waited for the title. The title now
+ * goes beside the wallet check and is awaited before any reply is sent.
+ */
+describe('the provisional title on an arriving message', () => {
+  const route = readFileSync(
+    join(__dirname, '..', '..', 'api', 'routes', 'threads.routes.ts'),
+    'utf8',
+  );
+
+  it('is started without waiting for it', () => {
+    expect(route).not.toMatch(/await updateThreadTitle\(threadId, provisionalTitle/u);
+    expect(route).toMatch(/const titled = needsTitle\s+\? updateThreadTitle\(/u);
+    expect(route).toContain('titled.catch(() => undefined);');
+  });
+
+  it('is awaited after the wallet check and before the 402 or the 202', () => {
+    const awaited = route.indexOf('await titled;');
+    expect(awaited).toBeGreaterThan(route.indexOf('checkRunAllowance(payerId)'));
+    expect(awaited).toBeLessThan(route.indexOf('res.status(402)'));
+    expect(awaited).toBeLessThan(route.indexOf('res.status(202).json({ success: true, runId })'));
+  });
+});
diff --git a/src/services/__tests__/tokenWallet.service.test.ts b/src/services/__tests__/tokenWallet.service.test.ts
index 0ac6ce1..a466900 100644
--- a/src/services/__tests__/tokenWallet.service.test.ts
+++ b/src/services/__tests__/tokenWallet.service.test.ts
@@ -188,6 +188,42 @@ describe('checkRunAllowance', () => {
     setWorld({ walletEnabled: true, subscriptionStatus: 'active', balance: 0, runCostUsd: 0 });
     expect(await checkRunAllowance('7')).toEqual({ allowed: false, balance: 0 });
   });
+
+  // Run 9 (16 Oct): each trip is ~150 ms; the subscription read waits for nothing.
+  it('reads the subscription while the expiry is still being read', async () => {
+    setWorld({ walletEnabled: true, subscriptionStatus: 'active', balance: 5, runCostUsd: 0 });
+    const world = mockQuery.getMockImplementation();
+    let releaseExpiry: () => void = () => undefined;
+    const expiryHeld = new Promise<void>((resolve) => {
+      releaseExpiry = resolve;
+    });
+    let subscriptionReadEarly = false;
+    let expiryOpen = false;
+    mockQuery.mockImplementation(async (sql: string, params?: unknown[]) => {
+      if (sql.includes('NOT EXISTS')) {
+        expiryOpen = true;
+        await expiryHeld;
+        expiryOpen = false;
+        return rows([]) as never;
+      }
+      if (sql.includes('subscription_status') && expiryOpen) subscriptionReadEarly = true;
+      if (sql.includes('subscription_status')) releaseExpiry();
+      return world!(sql, params) as never;
+    });
+
+    expect(await checkRunAllowance('7')).toEqual({ allowed: true, balance: 5 });
+    expect(subscriptionReadEarly).toBe(true);
+  });
+
+  it('still grants only after the expiry has been settled', async () => {
+    setWorld({ walletEnabled: true, subscriptionStatus: 'active', balance: 5, runCostUsd: 0 });
+    await checkRunAllowance('7');
+    const sqls = mockQuery.mock.calls.map(([sql]) => sql as string);
+    const expiry = sqls.findIndex((sql) => sql.includes('NOT EXISTS'));
+    const grant = sqls.findIndex((sql) => sql.includes('INSERT INTO token_transactions'));
+    expect(expiry).toBeGreaterThan(-1);
+    expect(grant).toBeGreaterThan(expiry);
+  });
 });
 
