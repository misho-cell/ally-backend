Conv 46829: „შემაფასე ქულით" → „ჩემი პირველი შთაბეჭდილებით, 8,5  10-დან." The
score filter knew „N/10", „out of 10", „ქულა 10", but not a bare „N 10-დან"
(here with two spaces) or „N ათიდან". Both are caught now; the sentence goes,
the observations stay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HwFREQwL5g9E6qRrUf9bau
---
 src/services/__tests__/noScoreForTheOwner.test.ts | 7 +++++++
 src/services/noScores.ts                          | 5 +++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/services/__tests__/noScoreForTheOwner.test.ts b/src/services/__tests__/noScoreForTheOwner.test.ts
index cda0145..ef57f3c 100644
--- a/src/services/__tests__/noScoreForTheOwner.test.ts
+++ b/src/services/__tests__/noScoreForTheOwner.test.ts
@@ -50,6 +50,13 @@ describe('no score for the owner', () => {
     );
   });
 
+  it('drops a bare „N 10-დან" too (47991, conv 46829)', () => {
+    expect(
+      withoutScores('ჩემი პირველი შთაბეჭდილებით, 8,5  10-დან. პირდაპირი ხარ და საქმეზე გადადიხარ.'),
+    ).toBe('პირდაპირი ხარ და საქმეზე გადადიხარ.');
+    expect(withoutScores('7 ათიდან. პირდაპირი ხარ.')).toBe('პირდაპირი ხარ.');
+  });
+
   it('leaves a reply with no score alone', () => {
     const reply = 'პირდაპირი ხარ. 3 დღეში დაგიბრუნდები.';
     expect(withoutScores(reply)).toBe(reply);
diff --git a/src/services/noScores.ts b/src/services/noScores.ts
index 4ec6f99..ffbf5d1 100644
--- a/src/services/noScores.ts
+++ b/src/services/noScores.ts
@@ -56,9 +56,10 @@ export function asksForAScore(ownerLine: string): boolean {
   return ASKS_FOR_A_SCORE_RE.test(ownerLine);
 }
 
-/** „6/10", „8 / 10", „7 out of 10", „8 ქულა 10-დან". */
+/** „6/10", „8 / 10", „7 out of 10", „8 ქულა 10-დან", „8,5 10-დან". */
+// 47991 (conv 46829): „8,5  10-დან" — a bare „N 10-დან", two spaces — passed. Any „10-დან"/„ათიდან" after a number is a score.
 const SCORE_RE =
-  /\b\d{1,2}(?:[.,]\d)?\s*(?:\/\s*10\b|out\s+of\s+10\b|ქულა\s+10|из\s+10\b|de\s+10\b)/iu;
+  /\b\d{1,2}(?:[.,]\d)?\s*(?:\/\s*10\b|out\s+of\s+10\b|ქულა\s+10|(?:ქულა\s+)?10\s*-?\s*დან|ათიდან|из\s+10\b|de\s+10\b)/iu;
 
 /**
  * 47978 (46817): with the score gone, „…to rate you higher with confidence."
